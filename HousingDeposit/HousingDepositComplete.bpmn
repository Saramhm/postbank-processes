    <bpmn:intermediateCatchEvent id="Catch_SettlementDue" name="سررسید تسویه / پایان مهلت استفاده">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">try {
  var raw = execution.getVariable("Submission");
  var obj = (raw &amp;&amp; typeof raw.prop === "function") ? JSON.parse(raw.toString()) : (typeof raw === "string" ? JSON.parse(raw) : { data: {} });
  if (!obj.data) { obj = { data: obj }; }
  var reason = execution.getVariable("ExitReason");
  if (reason !== null &amp;&amp; reason !== undefined &amp;&amp; String(reason) !== "") { obj.data.ExitReason = String(reason); }
  else if (!obj.data.ExitReason) { obj.data.ExitReason = "periodEnd"; }
  execution.setVariable("Submission", S(JSON.stringify(obj)));
  console.log("[Catch_SettlementDue] ExitReason=" + obj.data.ExitReason);
} catch (e) { console.error("[Catch_SettlementDue] " + e); }
</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Gateway_ExitWait_Catch_SettlementDue</bpmn:incoming>
