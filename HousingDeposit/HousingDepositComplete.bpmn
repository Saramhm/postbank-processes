    <bpmn:sequenceFlow id="Flow_Catch_SettlementDue_Notify_Exit" name="سررسید" sourceRef="Catch_SettlementDue" targetRef="Notify_Exit" />
    <bpmn:sequenceFlow id="Flow_Notify_Exit_Notify_Settlement" sourceRef="Notify_Exit" targetRef="Notify_Settlement" />
