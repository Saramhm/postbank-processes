<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_HousingDepositComplete" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.17.0">
  <bpmn:collaboration id="Collaboration_HousingDepositComplete">
    <bpmn:participant id="Participant_HousingDepositComplete" name="پست بانک ایران" processRef="HousingDepositComplete" />
    <bpmn:participant id="Participant_Notary" name="دفتر اسناد رسمی (دفترخانه)" />
    <bpmn:messageFlow id="MessageFlow_1" name="تنظیم اقرارنامه" sourceRef="Notify_File" targetRef="Participant_Notary" />
    <bpmn:messageFlow id="MessageFlow_2" sourceRef="Participant_Notary" targetRef="Task_Payment" />
    <bpmn:textAnnotation id="TextAnnotation_1">
      <bpmn:text>شامل:
1- اقرارنامه
2- چک ضمانت معادل ۱۳۰٪ به امضای متعهدین
3- اصل اجاره‌نامه با کد رهگیری
4- فیش واریز به حساب موجر
5- درخواست تأییدشده
6- فرم ضمانت (نمونه ۲۲۲۷)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1" associationDirection="None" sourceRef="Task_File" targetRef="TextAnnotation_1" />
  </bpmn:collaboration>
  <bpmn:message id="Message_HousingDepositExitCoverage" name="HousingDeposit_ExitCoverage" />
  <bpmn:process id="HousingDepositComplete" name="ودیعه مسکن مدیران غیر بومی (فرآیند کامل)" isExecutable="true">
    <bpmn:laneSet id="LaneSet_HousingDepositComplete">
      <bpmn:lane id="Lane_Employee" name="کارکنان مشمول">
        <bpmn:flowNodeRef>Start_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Category</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LeaseInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CEO" name="مدیرعامل / معاونت ستادی">
        <bpmn:flowNodeRef>Task_CEOReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify_CEO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CEO</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ProvinceManagement" name="مدیریت شعب استان / منطقه / حراست">
        <bpmn:flowNodeRef>Task_ProvinceReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify_Province</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Province</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Referral</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="اداره کل سرمایه انسانی و رفاه">
        <bpmn:flowNodeRef>Gateway_ToHR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HRReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify_HR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Database</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify_Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ExitWait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_ExitMessage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_SettlementDue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify_Exit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify_Settlement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Handover</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Guarantor" name="ضامن">
        <bpmn:flowNodeRef>Task_GuarantorApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify_Guarantor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Guarantor</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Inspection" name="اداره کل بازرسی">
        <bpmn:flowNodeRef>Gateway_Route</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Inspection</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Legal" name="واحد حقوقی مدیریت شعب استان / منطقه">
        <bpmn:flowNodeRef>Notify_Legal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Legal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Executor" name="واحد مجری پرداخت (شعبه شهید بهشتی / ذی‌حساب استان)">
        <bpmn:flowNodeRef>Task_File</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify_File</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify_Paid</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Request" name="درخواست ودیعه مسکن (تکمیل فرم ۲۲۲۵ / ۲۲۲۴)" camunda:formKey="65" camunda:initiator="PM">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">
try {
  var raw = execution.getVariable("Submission");
  if (raw === null || raw === undefined) {
    execution.setVariable("Submission", S("{\"data\":{}}"));
  } else if (typeof raw === "string") {
    // string -&gt; Spin
    execution.setVariable("Submission", S(raw));
  } else if (raw &amp;&amp; typeof raw.prop === "function") {
    // already Spin - leave it
  } else {
    // Map / other Java object - convert via string
    try {
      var str = JSON.stringify(raw);
      execution.setVariable("Submission", S(str));
    } catch (e1) {
      execution.setVariable("Submission", S("{\"data\":{}}"));
    }
  }
} catch (e) {
  console.error("[PrepareSpin] " + e);
}
</camunda:script>
        </camunda:executionListener>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">try {
  var raw = execution.getVariable("Submission");
  var data = {};
  if (raw &amp;&amp; typeof raw.prop === "function") {
    if (raw.hasProp("data") &amp;&amp; !raw.prop("data").isNull()) { data = JSON.parse(raw.prop("data").toString()); }
    else { data = JSON.parse(raw.toString()); }
  } else if (typeof raw === "string") {
    var parsed = JSON.parse(raw); data = (parsed &amp;&amp; parsed.data) ? parsed.data : (parsed || {});
  } else if (raw) { data = raw.data || raw; }
  execution.setVariable("_requestCategory", (data.RequestCategory !== undefined &amp;&amp; data.RequestCategory !== null) ? String(data.RequestCategory) : "");
  console.log("[Start_Request]" + " _requestCategory=" + execution.getVariable("_requestCategory"));
} catch(e) { console.error("[Start_Request] " + e); }
</camunda:script>
        </camunda:executionListener>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">try {
  var raw = execution.getVariable("Submission");
  var obj = null;
  if (raw === null || raw === undefined) { obj = { data: {} }; }
  else if (typeof raw === "string") { obj = JSON.parse(raw); }
  else if (raw &amp;&amp; typeof raw.prop === "function") { obj = JSON.parse(raw.toString()); }
  else { try { obj = JSON.parse(JSON.stringify(raw)); } catch (e1) { obj = { data: {} }; } }
  if (!obj.data) { obj = { data: obj }; }
  var d = obj.data;
  function hdG2J(gy, gm, gd) { var g_d_m = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334]; var gy2 = (gm &gt; 2) ? (gy + 1) : gy; var days = 355666 + (365 * gy) + Math.floor((gy2 + 3) / 4) - Math.floor((gy2 + 99) / 100) + Math.floor((gy2 + 399) / 400) + gd + g_d_m[gm - 1]; var jy = -1595 + (33 * Math.floor(days / 12053)); days %= 12053; jy += 4 * Math.floor(days / 1461); days %= 1461; if (days &gt; 365) { jy += Math.floor((days - 1) / 365); days = (days - 1) % 365; } var jm, jd; if (days &lt; 186) { jm = 1 + Math.floor(days / 31); jd = 1 + (days % 31); } else { jm = 7 + Math.floor((days - 186) / 30); jd = 1 + ((days - 186) % 30); } return [jy, jm, jd]; }
function hdJ2G(jy, jm, jd) { jy += 1595; var days = -355668 + (365 * jy) + (Math.floor(jy / 33) * 8) + Math.floor(((jy % 33) + 3) / 4) + jd + ((jm &lt; 7) ? (jm - 1) * 31 : ((jm - 7) * 30) + 186); var gy = 400 * Math.floor(days / 146097); days %= 146097; if (days &gt; 36524) { days--; gy += 100 * Math.floor(days / 36524); days %= 36524; if (days &gt;= 365) { days++; } } gy += 4 * Math.floor(days / 1461); days %= 1461; if (days &gt; 365) { gy += Math.floor((days - 1) / 365); days = (days - 1) % 365; } var gd = days + 1; var ml = [0, 31, ((gy % 4 === 0 &amp;&amp; gy % 100 !== 0) || (gy % 400 === 0)) ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]; var gm; for (gm = 0; gm &lt; 13 &amp;&amp; gd &gt; ml[gm]; gm++) { gd -= ml[gm]; } return [gy, gm, gd]; }
function hdPad(n) { return (n &lt; 10 ? "0" : "") + n; }
function hdNow() { try { var Z = Java.type("java.time.ZonedDateTime"), I = Java.type("java.time.ZoneId"); var z = Z.now(I.of("Asia/Tehran")); var j = hdG2J(z.getYear(), z.getMonthValue(), z.getDayOfMonth()); return j[0] + "/" + hdPad(j[1]) + "/" + hdPad(j[2]) + " " + hdPad(z.getHour()) + ":" + hdPad(z.getMinute()); } catch (e) { var d = new Date(); var j2 = hdG2J(d.getFullYear(), d.getMonth() + 1, d.getDate()); return j2[0] + "/" + hdPad(j2[1]) + "/" + hdPad(j2[2]) + " " + hdPad(d.getHours()) + ":" + hdPad(d.getMinutes()); } }
  var log = d.InitiatorNotifications || [];
  log.push({ NoticeTitle: "ثبت درخواست", NoticeText: "درخواست ودیعه مسکن شما ثبت شد و برای بررسی " + (d.RequestCategory === "HQ" ? "به مدیرعامل" : "به مدیریت شعب استان / منطقه") + " ارسال گردید.", NoticeTime: hdNow() });
  d.InitiatorNotifications = log;
  execution.setVariable("Submission", S(JSON.stringify(obj)));
  console.log("[Start_Request] first notice added");
} catch (e) { console.error("[Start_Request] notice " + e); }
</camunda:script>
        </camunda:executionListener>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">try {
  var raw = execution.getVariable("Submission");
  var obj = null;
  if (raw === null || raw === undefined) { obj = { data: {} }; }
  else if (typeof raw === "string") { obj = JSON.parse(raw); }
  else if (raw &amp;&amp; typeof raw.prop === "function") { obj = JSON.parse(raw.toString()); }
  else { try { obj = JSON.parse(JSON.stringify(raw)); } catch (e1) { obj = { data: {} }; } }
  if (!obj.data) { obj = { data: obj }; }
  var d = obj.data;
  var cat = String(d.RequestCategory || "");
  var g = String(d.EligibilityGroup || "");
  var ttl = String(d.PostTitle || "");
  var grp;
  if (cat === "HQ") { grp = (g === "g1") ? "PBCEO" : "PBHQDeputy"; }
  else if (ttl.indexOf("حراست") &gt;= 0) { grp = "PBSecurityAffairs"; }
  else if (g === "g3") { grp = "PBProvincesAffairs"; }
  else { grp = "PBProvinceManagement"; }
  execution.setVariable("_approverGroup", grp);
  console.log("[ApproverRouting] _approverGroup=" + grp);
} catch (e) { console.error("[ApproverRouting] " + e); }
</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Start_Request_Gateway_Category</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_Category" name="نوع درخواست؟" default="Flow_Gateway_Category_Task_ProvinceReview">
      <bpmn:incoming>Flow_Start_Request_Gateway_Category</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_Category_Task_CEOReview</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_Category_Task_ProvinceReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CEOReview" name="بررسی درخواست" camunda:formKey="embedded:/camunda/forms/formioWizardCallApi.html?deployment=HousingDepositCompleteWizard.json&#38;var=Submission&#38;DefaultVal=Submission&#38;StateTask=1" camunda:assignee="${PM}" camunda:candidateGroups="${_approverGroup}">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="javascript">
try {
  var raw = execution.getVariable("Submission");
  var obj = null;
  if (raw === null || raw === undefined) {
    obj = { data: {}, metadata: {} };
  } else if (typeof raw === "string") {
    obj = JSON.parse(raw);
  } else if (raw &amp;&amp; typeof raw.prop === "function") {
    obj = JSON.parse(raw.toString());
  } else {
    try { obj = JSON.parse(JSON.stringify(raw)); } catch(e) { obj = { data: {} }; }
  }
  if (!obj.data) {
    obj = { data: obj, metadata: {} };
  }
  // Inject StateTask into form data so panel customConditional works
  obj.data.StateTask = "1";
  execution.setVariable("StateTask", "1");
  execution.setVariable("Submission", S(JSON.stringify(obj)));
  console.log("[Prepare] StateTask=1 injected into Submission.data");
} catch (e) {
  console.error("[Prepare] " + e);
  execution.setVariable("StateTask", "1");
}
</camunda:script>
        </camunda:executionListener>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">try {
  var raw = execution.getVariable("Submission");
  var data = {};
  if (raw &amp;&amp; typeof raw.prop === "function") {
    if (raw.hasProp("data") &amp;&amp; !raw.prop("data").isNull()) { data = JSON.parse(raw.prop("data").toString()); }
    else { data = JSON.parse(raw.toString()); }
  } else if (typeof raw === "string") {
    var parsed = JSON.parse(raw); data = (parsed &amp;&amp; parsed.data) ? parsed.data : (parsed || {});
  } else if (raw) { data = raw.data || raw; }
  execution.setVariable("_ceoApproval", (data.CEOApproval !== undefined &amp;&amp; data.CEOApproval !== null) ? String(data.CEOApproval) : "");
  console.log("[Task_CEOReview]" + " _ceoApproval=" + execution.getVariable("_ceoApproval"));
} catch(e) { console.error("[Task_CEOReview] " + e); }
</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Gateway_Category_Task_CEOReview</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_CEOReview_Notify_CEO</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="Notify_CEO" name="اطلاع نتیجه به متقاضی">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="javascript">try {
  var raw = execution.getVariable("Submission");
  var obj = null;
  if (raw === null || raw === undefined) { obj = { data: {} }; }
  else if (typeof raw === "string") { obj = JSON.parse(raw); }
  else if (raw &amp;&amp; typeof raw.prop === "function") { obj = JSON.parse(raw.toString()); }
  else { try { obj = JSON.parse(JSON.stringify(raw)); } catch (e1) { obj = { data: {} }; } }
  if (!obj.data) { obj = { data: obj }; }
  var d = obj.data;
  function fmt(n) { n = Math.round(Number(n || 0)); return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ","); }
  function note(s) { return s ? " توضیحات: " + s : ""; }
  function hdG2J(gy, gm, gd) { var g_d_m = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334]; var gy2 = (gm &gt; 2) ? (gy + 1) : gy; var days = 355666 + (365 * gy) + Math.floor((gy2 + 3) / 4) - Math.floor((gy2 + 99) / 100) + Math.floor((gy2 + 399) / 400) + gd + g_d_m[gm - 1]; var jy = -1595 + (33 * Math.floor(days / 12053)); days %= 12053; jy += 4 * Math.floor(days / 1461); days %= 1461; if (days &gt; 365) { jy += Math.floor((days - 1) / 365); days = (days - 1) % 365; } var jm, jd; if (days &lt; 186) { jm = 1 + Math.floor(days / 31); jd = 1 + (days % 31); } else { jm = 7 + Math.floor((days - 186) / 30); jd = 1 + ((days - 186) % 30); } return [jy, jm, jd]; }
function hdJ2G(jy, jm, jd) { jy += 1595; var days = -355668 + (365 * jy) + (Math.floor(jy / 33) * 8) + Math.floor(((jy % 33) + 3) / 4) + jd + ((jm &lt; 7) ? (jm - 1) * 31 : ((jm - 7) * 30) + 186); var gy = 400 * Math.floor(days / 146097); days %= 146097; if (days &gt; 36524) { days--; gy += 100 * Math.floor(days / 36524); days %= 36524; if (days &gt;= 365) { days++; } } gy += 4 * Math.floor(days / 1461); days %= 1461; if (days &gt; 365) { gy += Math.floor((days - 1) / 365); days = (days - 1) % 365; } var gd = days + 1; var ml = [0, 31, ((gy % 4 === 0 &amp;&amp; gy % 100 !== 0) || (gy % 400 === 0)) ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]; var gm; for (gm = 0; gm &lt; 13 &amp;&amp; gd &gt; ml[gm]; gm++) { gd -= ml[gm]; } return [gy, gm, gd]; }
function hdPad(n) { return (n &lt; 10 ? "0" : "") + n; }
function hdNow() { try { var Z = Java.type("java.time.ZonedDateTime"), I = Java.type("java.time.ZoneId"); var z = Z.now(I.of("Asia/Tehran")); var j = hdG2J(z.getYear(), z.getMonthValue(), z.getDayOfMonth()); return j[0] + "/" + hdPad(j[1]) + "/" + hdPad(j[2]) + " " + hdPad(z.getHour()) + ":" + hdPad(z.getMinute()); } catch (e) { var d = new Date(); var j2 = hdG2J(d.getFullYear(), d.getMonth() + 1, d.getDate()); return j2[0] + "/" + hdPad(j2[1]) + "/" + hdPad(j2[2]) + " " + hdPad(d.getHours()) + ":" + hdPad(d.getMinutes()); } }
  var name = ((d.ApplicantFirstName || "") + " " + (d.ApplicantLastName || "")).trim();
  var title = "نتیجه بررسی مدیرعامل";
  var text = (d.CEOApproval === "approved" ? "درخواست ودیعه مسکن شما توسط مدیرعامل تأیید شد و برای بررسی به اداره کل سرمایه انسانی و رفاه ارسال گردید." : "درخواست ودیعه مسکن شما توسط مدیرعامل تأیید نشد و فرآیند خاتمه یافت.") + note(d.CEONote);
  var log = d.InitiatorNotifications || [];
  log.push({ NoticeTitle: title, NoticeText: text, NoticeTime: hdNow() });
  d.InitiatorNotifications = log;
  execution.setVariable("Submission", S(JSON.stringify(obj)));
  execution.setVariable("_lastNotice", title + ": " + text);
  var pm = execution.getVariable("PM");
  if (pm) {
    var nt = hdNow();
    try {
      var nobj = JSON.parse(JSON.stringify(obj));
      nobj.data.StateTask = "0";
      nobj.data.NoticeTitle = title;
      nobj.data.NoticeText = text;
      nobj.data.NoticeTime = nt;
      var HashMap = Java.type("java.util.HashMap");
      var vars = new HashMap();
      vars.put("PM", String(pm));
      vars.put("StateTask", "0");
      vars.put("NoticeTaskName", "اطلاع: " + title);
      vars.put("NoticeTitle", title);
      vars.put("NoticeText", text);
      vars.put("NoticeTime", nt);
      vars.put("SourceProcessInstanceId", execution.getProcessInstanceId());
      vars.put("Submission", S(JSON.stringify(nobj)));
      var rs = execution.getProcessEngineServices().getRuntimeService();
      var bk = execution.getProcessBusinessKey();
      if (bk) { rs.startProcessInstanceByKey("HousingDepositNotice", String(bk), vars); }
      else { rs.startProcessInstanceByKey("HousingDepositNotice", vars); }
    } catch (eN) {
      console.error("[Notice] HousingDepositNotice not started, falling back to plain task: " + eN);
      var ts = execution.getProcessEngineServices().getTaskService();
      var t = ts.newTask();
      t.setName("اطلاع: " + title);
      t.setDescription(text);
      t.setAssignee(String(pm));
      ts.saveTask(t);
    }
  }
  console.log("[Notify_CEO] " + title);
} catch (e) { console.error("[Notify_CEO] " + e); }
</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Task_CEOReview_Notify_CEO</bpmn:incoming>
      <bpmn:outgoing>Flow_Notify_CEO_Gateway_CEO</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Notify_CEO" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="Task_ProvinceReview" name="بررسی درخواست" camunda:formKey="embedded:/camunda/forms/formioWizardCallApi.html?deployment=HousingDepositCompleteWizard.json&#38;var=Submission&#38;DefaultVal=Submission&#38;StateTask=2" camunda:assignee="${PM}" camunda:candidateGroups="${_approverGroup}">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="javascript">
try {
  var raw = execution.getVariable("Submission");
  var obj = null;
  if (raw === null || raw === undefined) {
    obj = { data: {}, metadata: {} };
  } else if (typeof raw === "string") {
    obj = JSON.parse(raw);
  } else if (raw &amp;&amp; typeof raw.prop === "function") {
    obj = JSON.parse(raw.toString());
  } else {
    try { obj = JSON.parse(JSON.stringify(raw)); } catch(e) { obj = { data: {} }; }
  }
  if (!obj.data) {
    obj = { data: obj, metadata: {} };
  }
  // Inject StateTask into form data so panel customConditional works
  obj.data.StateTask = "2";
  execution.setVariable("StateTask", "2");
  execution.setVariable("Submission", S(JSON.stringify(obj)));
