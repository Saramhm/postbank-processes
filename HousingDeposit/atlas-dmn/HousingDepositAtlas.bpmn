<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_HousingDepositAtlas" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.26.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.17.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="ودیعه مسکن مدیران غیر بومی (فرآیند کامل)" processRef="HousingDepositComplete" />
  </bpmn:collaboration>
  <bpmn:process id="HousingDepositComplete" name="ودیعه مسکن مدیران غیر بومی (فرآیند کامل)" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Employee" name="کارکنان مشمول">
        <bpmn:flowNodeRef>Task_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproverRouting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Category</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NeedFinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Route</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CEO" name="مدیر مستقیم">
        <bpmn:flowNodeRef>Gateway_Direct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CEO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CEOReview</bpmn:flowNodeRef>
        
        <bpmn:flowNodeRef>Task_FinalApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RejectedFinal</bpmn:flowNodeRef>
        
      </bpmn:lane>
      <bpmn:lane id="Lane_Province" name="مدیریت شعب استان / منطقه">
        <bpmn:flowNodeRef>Task_ProvinceReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IsSec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReferralProvince</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Province</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="اداره کل سرمایه انسانی و رفاه">
        <bpmn:flowNodeRef>Task_HRHeadAssign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HRExpert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HRReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HRHeadReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Database</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RejectedHQ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Inspection" name="اداره کل بازرسی">
        <bpmn:flowNodeRef>Task_Inspection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Inspection</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Legal" name="واحد حقوقی">
        <bpmn:flowNodeRef>Task_Legal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Executor" name="ذی‌حساب / شعبه (واحد مجری پرداخت)">
        <bpmn:flowNodeRef>Gateway_HQ1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BranchRefAcc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AccApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RejectedAcc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HQ2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BranchRefAccountant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LeaseInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReferralBranch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_File</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Payment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Security" name="حراست تهران (مرکز)">
        <bpmn:flowNodeRef>Task_SecurityReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SecOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RejectedSec</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="End_Rejected" name="پایان (عدم تأیید)">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:incoming>F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_RejectedHQ" name="پایان (عدم تأیید)">
      <bpmn:incoming>F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Inspection" name="پایان (رونوشت بازرسی)">
      <bpmn:incoming>F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Completed" name="پایان (تکمیل پرونده)">
      <bpmn:incoming>F26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Request" name="ارائه درخواست ودیعه مسکن" camunda:asyncBefore="true" camunda:formKey="65" camunda:assignee="${starter}">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:userTask> 
    <bpmn:userTask id="Task_ProvinceReview" name="بررسی درخواست – مدیریت شعب استان / منطقه" camunda:asyncBefore="true" camunda:formKey="FORM_PROVINCE" camunda:assignee="${starter}">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_IsSec" name="رئیس حوزه حراست استان؟" default="Flow_IsSec_No">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>Flow_IsSec_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_IsSec_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_SecurityReview" name="بررسی و تأیید – حراست تهران (مرکز)" camunda:asyncBefore="true" camunda:formKey="FORM_SECURITY" camunda:assignee="${starter}">
      <bpmn:incoming>Flow_IsSec_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Sec_G</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_SecOK" name="آیا مورد تأیید می‌باشد؟">
      <bpmn:incoming>Flow_Sec_G</bpmn:incoming>
      <bpmn:outgoing>Flow_Sec_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Sec_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_RejectedSec" name="پایان (عدم تأیید حراست)">
      <bpmn:incoming>Flow_Sec_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_CEOReview" name="بررسی درخواست – مدیر مستقیم" camunda:asyncBefore="true" camunda:formKey="FORM_CEO" camunda:assignee="${starter}">
      <bpmn:incoming>F03a</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_CEO" name="آیا مورد تأیید است؟">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_Direct" name="مدیر مستقیم مدیرعامل است؟" default="F03a">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F03b</bpmn:outgoing>
      <bpmn:outgoing>F03a</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_HRHeadAssign" name="رئیس اداره کل سرمایه انسانی – ارجاع به کارشناس" camunda:asyncBefore="true" camunda:formKey="FORM_HRHEAD" camunda:assignee="${starter}">
      <bpmn:incoming>F03b</bpmn:incoming>
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:incoming>Flow_IsSec_No</bpmn:incoming>
      <bpmn:incoming>Flow_Sec_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_HRHead_Expert</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_HRExpert" name="بررسی درخواست – کارشناس اداره کل سرمایه انسانی و رفاه" camunda:asyncBefore="true" camunda:formKey="FORM_HREXPERT" camunda:assignee="${starter}">
      <bpmn:incoming>Flow_HRHead_Expert</bpmn:incoming>
      <bpmn:outgoing>Flow_HRExpert_HR</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_HRReview" name="بررسی درخواست – اداره کل سرمایه انسانی و رفاه" camunda:asyncBefore="true" camunda:formKey="185" camunda:assignee="${starter}">
      <bpmn:incoming>Flow_HRExpert_HR</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_LeaseInfo" name="تکمیل اطلاعات ملک و قرارداد اجاره (ذی‌حساب، پس از واریز)" camunda:asyncBefore="true" camunda:formKey="FORM_LEASE" camunda:assignee="${starter}">
      <bpmn:incoming>Flow_HQ2_No</bpmn:incoming>
      <bpmn:incoming>Flow_BRA_Lease</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Inspection" name="رونوشت به اداره کل بازرسی" camunda:asyncBefore="true" camunda:formKey="FORM_INSPECTION" camunda:assignee="${starter}">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReferralProvince" name="ارجاع برای پرداخت – مدیریت شعب استان / منطقه" camunda:asyncBefore="true" camunda:formKey="FORM_REFERRAL" camunda:assignee="${starter}">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReferralBranch" name="ارجاع برای پرداخت – شعبه" camunda:asyncBefore="true" camunda:formKey="FORM_REFERRAL" camunda:assignee="${starter}">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Legal" name="اخذ چک صیادی (۱۳۰٪)، اقرارنامه و ضمانت – واحد حقوقی" camunda:asyncBefore="true" camunda:formKey="FORM_LEGAL" camunda:assignee="${starter}">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_File" name="تشکیل پرونده – ذی‌حساب / شعبه" camunda:asyncBefore="true" camunda:formKey="FORM_FILE" camunda:assignee="${starter}">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_HQ1" name="نوع درخواست؟" default="Flow_HQ1_No">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>Flow_HQ1_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_HQ1_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_BranchRefAcc" name="رئیس شعبه – ارجاع به رئیس حوزه حسابداری شعبه" camunda:asyncBefore="true" camunda:formKey="21" camunda:assignee="${starter}">
      <bpmn:incoming>Flow_HQ1_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_BR_AA</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_AccApproval" name="رئیس حوزه حسابداری شعبه – تأیید" camunda:asyncBefore="true" camunda:formKey="23" camunda:assignee="${starter}">
      <bpmn:incoming>Flow_BR_AA</bpmn:incoming>
      <bpmn:outgoing>Flow_AA_G</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Acc" name="آیا مورد تأیید می‌باشد؟">
      <bpmn:incoming>Flow_AA_G</bpmn:incoming>
      <bpmn:outgoing>Flow_Acc_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Acc_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_RejectedAcc" name="پایان (عدم تأیید حسابداری شعبه)">
      <bpmn:incoming>Flow_Acc_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_HQ2" name="نوع درخواست؟" default="Flow_HQ2_No">
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>Flow_HQ2_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_HQ2_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_BranchRefAccountant" name="رئیس شعبه – ارجاع به ذی‌حساب" camunda:asyncBefore="true" camunda:formKey="22" camunda:assignee="${starter}">
      <bpmn:incoming>Flow_HQ2_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_BRA_Lease</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Payment" name="واریز ودیعه و صدور سند حسابداری (ستاد: رئیس حوزه حسابداری شعبه)" camunda:asyncBefore="true" camunda:formKey="FORM_PAYMENT" camunda:assignee="${starter}">
      <bpmn:incoming>Flow_HQ1_No</bpmn:incoming>
      <bpmn:incoming>Flow_Acc_Yes</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Database" name="دریافت مستندات و تکمیل بانک اطلاعات دریافت‌کنندگان" camunda:asyncBefore="true" camunda:formKey="FORM_DATABASE" camunda:assignee="${starter}">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="Task_ApproverRouting" name="تعیین مسیر تأیید (جدول DMN)" camunda:asyncBefore="true" camunda:resultVariable="approverRoute" camunda:decisionRef="ApproverRouting" camunda:decisionRefBinding="latest" camunda:mapDecisionResult="singleEntry">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F02b</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Category" name="نوع درخواست؟">
      <bpmn:incoming>F02b</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:exclusiveGateway> 
    <bpmn:exclusiveGateway id="Gateway_Province" name="آیا مورد تأیید است؟">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_HR" name="آیا مورد تأیید است؟">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_Fork" name="رونوشت به بازرسی (همزمان)">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_NeedFinal" name="نوع درخواست؟" default="Flow_NF_No">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>Flow_NF_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_NF_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_FinalApproval" name="تأیید نهایی درخواست – مقام مافوق (مدیرعامل / معاون / مدیر امور)" camunda:asyncBefore="true" camunda:formKey="FORM_FINAL" camunda:assignee="${starter}">
      <bpmn:incoming>Flow_NF_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_FA_G</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Final" name="آیا مورد تأیید می‌باشد؟">
      <bpmn:incoming>Flow_FA_G</bpmn:incoming>
      <bpmn:outgoing>Flow_FA_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_FA_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_RejectedFinal" name="پایان (عدم تأیید مقام مافوق)">
      <bpmn:incoming>Flow_FA_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_HRHeadReferral" name="رئیس اداره کل سرمایه انسانی – ارجاع به شعبه / مدیریت استان" camunda:asyncBefore="true" camunda:formKey="FORM_HRHEAD" camunda:assignee="${starter}">
      <bpmn:incoming>Flow_FA_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_NF_No</bpmn:incoming>
      <bpmn:outgoing>Flow_HRRef_Route</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Route" name="نوع درخواست؟">
      <bpmn:incoming>Flow_HRRef_Route</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F01" sourceRef="StartEvent_1" targetRef="Task_Request" />
    <bpmn:sequenceFlow id="F02" sourceRef="Task_Request" targetRef="Task_ApproverRouting" />
    <bpmn:sequenceFlow id="F02b" sourceRef="Task_ApproverRouting" targetRef="Gateway_Category" />
    <bpmn:sequenceFlow id="F05" sourceRef="Task_CEOReview" targetRef="Gateway_CEO" />
    <bpmn:sequenceFlow id="F06" name="بله" sourceRef="Gateway_CEO" targetRef="Task_HRHeadAssign">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof CEOApproval !== "undefined" &amp;&amp; CEOApproval == "approved";</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F07" name="خیر" sourceRef="Gateway_CEO" targetRef="End_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof CEOApproval !== "undefined" &amp;&amp; CEOApproval == "rejected";</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F03a" name="سایر" sourceRef="Gateway_Direct" targetRef="Task_CEOReview" />
    <bpmn:sequenceFlow id="F03b" name="مدیرعامل" sourceRef="Gateway_Direct" targetRef="Task_HRHeadAssign">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof UpperManagerTitle !== "undefined" &amp;&amp; UpperManagerTitle == "مدیرعامل";</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F03" name="ستاد" sourceRef="Gateway_Category" targetRef="Gateway_Direct">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof approverRoute !== "undefined" &amp;&amp; approverRoute == "HQ";</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F04" name="استان" sourceRef="Gateway_Category" targetRef="Task_ProvinceReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof approverRoute !== "undefined" &amp;&amp; approverRoute == "Province";</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F08" sourceRef="Task_ProvinceReview" targetRef="Gateway_Province" />
    <bpmn:sequenceFlow id="Flow_IsSec_Yes" name="بله" sourceRef="Gateway_IsSec" targetRef="Task_SecurityReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof PostTitle !== "undefined" &amp;&amp; String(PostTitle).indexOf("حراست") &gt;= 0;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_IsSec_No" name="خیر" sourceRef="Gateway_IsSec" targetRef="Task_HRHeadAssign" />
