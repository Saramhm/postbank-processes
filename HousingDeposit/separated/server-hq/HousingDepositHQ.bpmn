  execution.setVariable("StateTask", "11");
  execution.setVariable("Submission", S(JSON.stringify(obj)));
  console.log("[Prepare] StateTask=11 injected into Submission.data");
} catch (e) {
  console.error("[Prepare] " + e);
  execution.setVariable("StateTask", "11");
}
</camunda:script>
        </camunda:executionListener>
