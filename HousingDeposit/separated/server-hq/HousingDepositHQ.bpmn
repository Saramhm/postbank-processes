      <bpmn:incoming>Flow_NSet_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Direct" sourceRef="Start_Request" targetRef="Gateway_Direct" />
    <bpmn:sequenceFlow id="Flow_Direct_CEO" name="مدیرعامل" sourceRef="Gateway_Direct" targetRef="Gateway_ToHR">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${_directIsCEO == "true"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Direct_Mgr" name="سایر" sourceRef="Gateway_Direct" targetRef="Task_CEOReview"/>
    <bpmn:sequenceFlow id="Flow_CEO_N" sourceRef="Task_CEOReview" targetRef="Notify_CEO"/>
    <bpmn:sequenceFlow id="Flow_N_CEO_G" sourceRef="Notify_CEO" targetRef="Gateway_CEO"/>
    <bpmn:sequenceFlow id="Flow_CEO_Yes" name="بله" sourceRef="Gateway_CEO" targetRef="Gateway_ToHR">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${_ceoApproval == "approved"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CEO_No" name="خیر" sourceRef="Gateway_CEO" targetRef="End_Rejected"/>
    <bpmn:sequenceFlow id="Flow_ToHR" sourceRef="Gateway_ToHR" targetRef="Task_HRHeadAssign"/>
    <bpmn:sequenceFlow id="Flow_HRHead_Expert" sourceRef="Task_HRHeadAssign" targetRef="Task_HRExpert"/>
    <bpmn:sequenceFlow id="Flow_HRExpert_HR" sourceRef="Task_HRExpert" targetRef="Task_HRReview"/>
    <bpmn:sequenceFlow id="Flow_HR_N" sourceRef="Task_HRReview" targetRef="Notify_HR"/>
    <bpmn:sequenceFlow id="Flow_N_HR_G" sourceRef="Notify_HR" targetRef="Gateway_HR"/>
    <bpmn:sequenceFlow id="Flow_HR_Yes" name="بله" sourceRef="Gateway_HR" targetRef="Gateway_Fork">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${_hrApproval == "approved"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow name="خیر" id="Flow_HR_NoHQ" sourceRef="Gateway_HR" targetRef="End_RejectedHQ">
      
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${_hrApproval != "approved"}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Fork_Insp" sourceRef="Gateway_Fork" targetRef="Notify_Inspection"/>
    <bpmn:sequenceFlow id="Flow_Insp_End" sourceRef="Notify_Inspection" targetRef="End_Inspection"/>
    <bpmn:sequenceFlow id="Flow_Fork_Route" sourceRef="Gateway_Fork" targetRef="Task_FinalApproval"/>
    <bpmn:sequenceFlow id="Flow_FA_G" sourceRef="Task_FinalApproval" targetRef="Gateway_Final"/>
    <bpmn:sequenceFlow id="Flow_FA_Yes" name="بله" sourceRef="Gateway_Final" targetRef="Task_HRHeadReferral">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${_finalApproval == "approved"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_FA_No" name="خیر" sourceRef="Gateway_Final" targetRef="End_RejectedFinal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${_finalApproval != "approved"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_HRRef_Route" sourceRef="Task_HRHeadReferral" targetRef="Task_ReferralBranch"/>
    <bpmn:sequenceFlow id="Flow_RefB_N" sourceRef="Task_ReferralBranch" targetRef="Notify_Legal"/>
    <bpmn:sequenceFlow id="Flow_N_Legal" sourceRef="Notify_Legal" targetRef="Task_Legal"/>
    <bpmn:sequenceFlow id="Flow_Legal_File" sourceRef="Task_Legal" targetRef="Task_File"/>
    <bpmn:sequenceFlow id="Flow_File_Pay" sourceRef="Task_File" targetRef="Task_BranchRefAcc"/>
    <bpmn:sequenceFlow id="Flow_BR_AA" sourceRef="Task_BranchRefAcc" targetRef="Task_AccApproval"/>
    <bpmn:sequenceFlow id="Flow_AA_G" sourceRef="Task_AccApproval" targetRef="Gateway_Acc"/>
    <bpmn:sequenceFlow id="Flow_Acc_Yes" name="بله" sourceRef="Gateway_Acc" targetRef="Task_Payment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${_accApproval == "approved"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Acc_No" name="خیر" sourceRef="Gateway_Acc" targetRef="End_RejectedAcc">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${_accApproval != "approved"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Pay_N" sourceRef="Task_Payment" targetRef="Notify_Paid"/>
    <bpmn:sequenceFlow id="Flow_N_Paid_DB" sourceRef="Notify_Paid" targetRef="Task_BranchRefAccountant"/>
    <bpmn:sequenceFlow id="Flow_BRA_Lease" sourceRef="Task_BranchRefAccountant" targetRef="Task_LeaseInfo"/>
    <bpmn:sequenceFlow id="Flow_Lease_DB" sourceRef="Task_LeaseInfo" targetRef="Task_Database"/>
    <bpmn:sequenceFlow id="Flow_DB_N" sourceRef="Task_Database" targetRef="Notify_Done"/>
    <bpmn:sequenceFlow id="Flow_N_Done_Wait" sourceRef="Notify_Done" targetRef="Gateway_ExitWait"/>
    <bpmn:sequenceFlow id="Flow_Wait_Msg" sourceRef="Gateway_ExitWait" targetRef="Catch_ExitMessage"/>
    <bpmn:sequenceFlow id="Flow_Wait_Due" sourceRef="Gateway_ExitWait" targetRef="Catch_SettlementDue"/>
    <bpmn:sequenceFlow id="Flow_Msg_NExit" name="رویداد خاص" sourceRef="Catch_ExitMessage" targetRef="Notify_Exit"/>
    <bpmn:sequenceFlow id="Flow_Due_NExit" name="سررسید" sourceRef="Catch_SettlementDue" targetRef="Notify_Exit"/>
    <bpmn:sequenceFlow id="Flow_NExit_NSet" sourceRef="Notify_Exit" targetRef="Notify_Settlement"/>
    <bpmn:sequenceFlow id="Flow_NSet_End" sourceRef="Notify_Settlement" targetRef="End_Handover"/>
  </bpmn:process>
