    <bpmn:sequenceFlow id="Flow_Route_HQ" name="ستاد (تأیید مدیر مافوق)" sourceRef="GW_Route" targetRef="Task_FinalApproval"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof RequestCategory !== 'undefined' &amp;&amp; RequestCategory == 'HQ';</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Route_Prov" name="استان / منطقه" sourceRef="GW_Route" targetRef="Task_HRHeadReferral" />
