<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_HousingDepositComplete" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.26.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.17.0">
  <bpmn:collaboration id="Collaboration_HousingDepositComplete">
    <bpmn:participant id="Participant_HousingDepositComplete" name="پست بانک ایران" processRef="HousingDepositComplete" />
  </bpmn:collaboration>
  <bpmn:process id="HousingDepositComplete" name="ودیعه مسکن مدیران غیر بومی" isExecutable="true">
    <bpmn:laneSet id="LaneSet_HousingDepositComplete">
      <bpmn:lane id="Lane_Employee" name="کارکنان مشمول">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Category</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="H_Lane_CEO" name="ستاد – مدیر مستقیم / مدیر مافوق">
        <bpmn:flowNodeRef>Gateway_Direct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CEOReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CEO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RejectedHQ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinalApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RejectedFinal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="اداره کل سرمایه انسانی و رفاه (ستاد و استان / منطقه)">
        <bpmn:flowNodeRef>Task_HRHeadAssign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HRExpert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HRReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HRHeadReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Database</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Completed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HRHeadAssign_PR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HRExpert_PR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HRReview_PR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HR_PR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Fork_PR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HRHeadReferral_PR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Database_PR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Join_PR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Completed_PR</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Inspection" name="رونوشت بازرسی – اداره کل بازرسی (ستاد و استان / منطقه)">
        <bpmn:flowNodeRef>Task_Inspection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Inspection_PR</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="H_Lane_Legal" name="ستاد – واحد حقوقی">
        <bpmn:flowNodeRef>Task_Legal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="H_Lane_Executor" name="ستاد – شعبه شهید بهشتی">
        <bpmn:flowNodeRef>Task_ReferralBranch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_File</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BranchRefAcc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AccApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RejectedAcc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BranchRefAccountant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LeaseInfo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P_Lane_ProvinceManagement" name="استان – مدیریت شعب استان / منطقه">
        <bpmn:flowNodeRef>Task_ProvinceReview_PR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Province_PR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected_PR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IsSec_PR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReferralProvince_PR</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P_Lane_Security" name="استان – مدیریت امور حراست">
        <bpmn:flowNodeRef>Task_SecurityReview_PR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SecOK_PR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RejectedSec_PR</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P_Lane_Legal" name="استان – واحد حقوقی (مدیریت شعب استان / منطقه)">
        <bpmn:flowNodeRef>Task_Legal_PR</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P_Lane_Executor" name="استان – ذی‌حساب مدیریت شعب استان / منطقه">
        <bpmn:flowNodeRef>Task_File_PR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Payment_PR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LeaseInfo_PR</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Request" name="ارائه درخواست ودیعه مسکن" camunda:asyncBefore="true" camunda:formKey="FORM_01" camunda:assignee="${starter}">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Category" name="نوع درخواست؟">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_Direct" name="مدیر مستقیم مدیرعامل است؟" default="F03a">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F03a</bpmn:outgoing>
      <bpmn:outgoing>F03b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ProvinceReview_PR" name="بررسی و تأیید – مدیریت شعب استان / منطقه" camunda:asyncBefore="true" camunda:formKey="FORM_PR_02" camunda:assignee="${starter}">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:incoming>F13_PR</bpmn:incoming>
      <bpmn:outgoing>F08_PR</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CEOReview" name="بررسی و تأیید – مدیر مستقیم" camunda:asyncBefore="true" camunda:formKey="FORM_HQ_02" camunda:assignee="${starter}">
      <bpmn:incoming>F03a</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Province_PR" name="آیا مورد تأیید است؟">
      <bpmn:incoming>F08_PR</bpmn:incoming>
      <bpmn:outgoing>F09_PR</bpmn:outgoing>
      <bpmn:outgoing>F10_PR</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Rejected_PR" name="پایان (عدم تأیید مدیریت شعب استان)">
      <bpmn:incoming>F10_PR</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_CEO" name="آیا مورد تأیید می‌باشد؟">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Rejected" name="پایان (عدم تأیید مدیر مستقیم)">
      <bpmn:incoming>F07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_IsSec_PR" name="رئیس حوزه حراست استان؟" default="Flow_IsSec_No_PR">
      <bpmn:incoming>F09_PR</bpmn:incoming>
      <bpmn:outgoing>Flow_IsSec_Yes_PR</bpmn:outgoing>
      <bpmn:outgoing>Flow_IsSec_No_PR</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_SecurityReview_PR" name="بررسی و تأیید – مدیر امور حراست" camunda:asyncBefore="true" camunda:formKey="FORM_PR_03" camunda:assignee="${starter}">
      <bpmn:incoming>Flow_IsSec_Yes_PR</bpmn:incoming>
      <bpmn:outgoing>Flow_Sec_G_PR</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_HRHeadAssign" name="رئیس اداره کل سرمایه انسانی – ارجاع به کارشناس" camunda:asyncBefore="true" camunda:formKey="FORM_HQ_03" camunda:assignee="${starter}">
      <bpmn:incoming>F03b</bpmn:incoming>
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>Flow_HRHead_Expert</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_SecOK_PR" name="آیا مورد تأیید می‌باشد؟">
      <bpmn:incoming>Flow_Sec_G_PR</bpmn:incoming>
      <bpmn:outgoing>Flow_Sec_Yes_PR</bpmn:outgoing>
      <bpmn:outgoing>Flow_Sec_No_PR</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_RejectedSec_PR" name="پایان (عدم تأیید مدیر امور حراست)">
      <bpmn:incoming>Flow_Sec_No_PR</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_HRExpert" name="بررسی درخواست – کارشناس اداره کل سرمایه انسانی" camunda:asyncBefore="true" camunda:formKey="FORM_HQ_04" camunda:assignee="${starter}">
      <bpmn:incoming>Flow_HRHead_Expert</bpmn:incoming>
      <bpmn:outgoing>Flow_HRExpert_HR</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_HRHeadAssign_PR" name="رئیس اداره کل سرمایه انسانی – ارجاع به کارشناس" camunda:asyncBefore="true" camunda:formKey="FORM_HQ_03" camunda:assignee="${starter}">
      <bpmn:incoming>Flow_IsSec_No_PR</bpmn:incoming>
      <bpmn:incoming>Flow_Sec_Yes_PR</bpmn:incoming>
      <bpmn:outgoing>Flow_HRHead_Expert_PR</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_HRReview" name="بررسی و تأیید – رئیس اداره کل سرمایه انسانی" camunda:asyncBefore="true" camunda:formKey="FORM_HQ_05" camunda:assignee="${starter}">
      <bpmn:incoming>Flow_HRExpert_HR</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_HRExpert_PR" name="بررسی درخواست – کارشناس اداره کل سرمایه انسانی" camunda:asyncBefore="true" camunda:formKey="FORM_HQ_04" camunda:assignee="${starter}">
      <bpmn:incoming>Flow_HRHead_Expert_PR</bpmn:incoming>
      <bpmn:outgoing>Flow_HRExpert_HR_PR</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_RejectedHQ" name="پایان (عدم تأیید رئیس اداره کل سرمایه انسانی)">
      <bpmn:incoming>F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_HR" name="آیا مورد تأیید است؟">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_Fork" name="رونوشت به بازرسی (همزمان)">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_HRReview_PR" name="بررسی و تأیید – رئیس اداره کل سرمایه انسانی" camunda:asyncBefore="true" camunda:formKey="FORM_HQ_05" camunda:assignee="${starter}">
      <bpmn:incoming>Flow_HRExpert_HR_PR</bpmn:incoming>
      <bpmn:outgoing>F11_PR</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_FinalApproval" name="تأیید مدیر مافوق" camunda:asyncBefore="true" camunda:formKey="FORM_HQ_06" camunda:assignee="${starter}">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>Flow_FA_G</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Inspection" name="رونوشت به اداره کل بازرسی" camunda:asyncBefore="true" camunda:formKey="FORM_HQ_15" camunda:assignee="${starter}">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>Flow_Insp_Join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_HR_PR" name="آیا مورد تأیید می‌باشد؟">
      <bpmn:incoming>F11_PR</bpmn:incoming>
      <bpmn:outgoing>F12_PR</bpmn:outgoing>
      <bpmn:outgoing>F13_PR</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_Fork_PR" name="رونوشت به بازرسی (همزمان)">
      <bpmn:incoming>F12_PR</bpmn:incoming>
      <bpmn:outgoing>F16_PR</bpmn:outgoing>
      <bpmn:outgoing>F15_PR</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_Final" name="آیا مورد تأیید می‌باشد؟">
      <bpmn:incoming>Flow_FA_G</bpmn:incoming>
      <bpmn:outgoing>Flow_FA_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_FA_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_RejectedFinal" name="پایان (عدم تأیید مدیر مافوق)">
      <bpmn:incoming>Flow_FA_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_HRHeadReferral_PR" name="رئیس اداره کل سرمایه انسانی – ارجاع به مدیریت شعب استان / منطقه" camunda:asyncBefore="true" camunda:formKey="FORM_HQ_03" camunda:assignee="${starter}">
      <bpmn:incoming>F15_PR</bpmn:incoming>
      <bpmn:outgoing>Flow_HRRef_Route_PR</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Inspection_PR" name="رونوشت به اداره کل بازرسی" camunda:asyncBefore="true" camunda:formKey="FORM_HQ_15" camunda:assignee="${starter}">
      <bpmn:incoming>F16_PR</bpmn:incoming>
      <bpmn:outgoing>Flow_Insp_Join_PR</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_HRHeadReferral" name="رئیس اداره کل سرمایه انسانی – ارجاع به شعبه شهید بهشتی" camunda:asyncBefore="true" camunda:formKey="FORM_HQ_03" camunda:assignee="${starter}">
      <bpmn:incoming>Flow_FA_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_HRRef_Route</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReferralProvince_PR" name="ارجاع برای پرداخت – مدیریت شعب استان / منطقه" camunda:asyncBefore="true" camunda:formKey="FORM_PR_07" camunda:assignee="${starter}">
      <bpmn:incoming>Flow_HRRef_Route_PR</bpmn:incoming>
      <bpmn:outgoing>F21_PR</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReferralBranch" name="ارجاع برای پرداخت – شعبه شهید بهشتی" camunda:asyncBefore="true" camunda:formKey="FORM_HQ_07" camunda:assignee="${starter}">
      <bpmn:incoming>Flow_HRRef_Route</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Legal_PR" name="اخذ چک صیادی (۱۳۰٪)، اقرارنامه و ضمانت – واحد حقوقی مدیریت شعب" camunda:asyncBefore="true" camunda:formKey="FORM_PR_08" camunda:assignee="${starter}">
      <bpmn:incoming>F21_PR</bpmn:incoming>
      <bpmn:outgoing>F23_PR</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Legal" name="اخذ چک صیادی (۱۳۰٪)، اقرارنامه، ضمانت و شماره حساب واسط – واحد حقوقی" camunda:asyncBefore="true" camunda:formKey="FORM_HQ_08" camunda:assignee="${starter}">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_File_PR" name="تشکیل پرونده – ذی‌حساب مدیریت شعب استان / منطقه" camunda:asyncBefore="true" camunda:formKey="FORM_PR_09" camunda:assignee="${starter}">
      <bpmn:incoming>F23_PR</bpmn:incoming>
      <bpmn:outgoing>F24_PR</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_File" name="تشکیل پرونده – شعبه شهید بهشتی" camunda:asyncBefore="true" camunda:formKey="FORM_HQ_09" camunda:assignee="${starter}">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Payment_PR" name="واریز ودیعه و صدور سند حسابداری – ذی‌حساب مدیریت شعب استان / منطقه" camunda:asyncBefore="true" camunda:formKey="FORM_PR_10" camunda:assignee="${starter}">
      <bpmn:incoming>F24_PR</bpmn:incoming>
      <bpmn:outgoing>F25_PR</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BranchRefAcc" name="رئیس شعبه شهید بهشتی – ارجاع به رئیس حوزه حسابداری شعبه" camunda:asyncBefore="true" camunda:formKey="FORM_HQ_10" camunda:assignee="${starter}">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>Flow_BR_AA</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_LeaseInfo_PR" name="تکمیل اطلاعات ملک و قرارداد اجاره – ذی‌حساب" camunda:asyncBefore="true" camunda:formKey="FORM_PR_11" camunda:assignee="${starter}">
      <bpmn:incoming>F25_PR</bpmn:incoming>
      <bpmn:outgoing>F27_PR</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_AccApproval" name="رئیس حوزه حسابداری شعبه – تأیید" camunda:asyncBefore="true" camunda:formKey="FORM_HQ_11" camunda:assignee="${starter}">
      <bpmn:incoming>Flow_BR_AA</bpmn:incoming>
      <bpmn:outgoing>Flow_AA_G</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Database_PR" name="دریافت مستندات و تکمیل بانک اطلاعات دریافت‌کنندگان" camunda:asyncBefore="true" camunda:formKey="FORM_PR_12" camunda:assignee="${starter}">
      <bpmn:incoming>F27_PR</bpmn:incoming>
      <bpmn:outgoing>Flow_DB_Join_PR</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Acc" name="آیا مورد تأیید می‌باشد؟">
      <bpmn:incoming>Flow_AA_G</bpmn:incoming>
      <bpmn:outgoing>Flow_Acc_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Acc_No</bpmn:outgoing>
