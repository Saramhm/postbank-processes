    <bpmn:endEvent id="End_RejectedAcc" name="پایان (عدم تأیید حسابداری شعبه)">
      <bpmn:incoming>Flow_Acc_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="Gateway_Join_PR" name="پایان همزمان (رونوشت بازرسی و تکمیل پرونده)">
      <bpmn:incoming>Flow_Insp_Join_PR</bpmn:incoming>
      <bpmn:incoming>Flow_DB_Join_PR</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_End_PR</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:userTask id="Task_Payment" name="واریز ودیعه و صدور سند حسابداری – رئیس حوزه حسابداری شعبه" camunda:asyncBefore="true" camunda:formKey="FORM_HQ_12" camunda:assignee="${starter}">
      <bpmn:incoming>Flow_Acc_Yes</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Completed_PR" name="پایان (تکمیل پرونده)">
      <bpmn:incoming>Flow_Join_End_PR</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_BranchRefAccountant" name="رئیس شعبه شهید بهشتی – ارجاع به ذی‌حساب" camunda:asyncBefore="true" camunda:formKey="FORM_HQ_10" camunda:assignee="${starter}">
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>Flow_BRA_Lease</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_LeaseInfo" name="تکمیل اطلاعات ملک و قرارداد اجاره – ذی‌حساب" camunda:asyncBefore="true" camunda:formKey="FORM_HQ_13" camunda:assignee="${starter}">
      <bpmn:incoming>Flow_BRA_Lease</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Database" name="دریافت مستندات و تکمیل بانک اطلاعات دریافت‌کنندگان" camunda:asyncBefore="true" camunda:formKey="FORM_HQ_14" camunda:assignee="${starter}">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>Flow_DB_Join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_Join" name="پایان همزمان (رونوشت بازرسی و تکمیل پرونده)">
      <bpmn:incoming>Flow_Insp_Join</bpmn:incoming>
      <bpmn:incoming>Flow_DB_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_End</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:endEvent id="End_Completed" name="پایان (تکمیل پرونده)">
      <bpmn:incoming>Flow_Join_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="StartEvent_1" targetRef="Task_Request"/>
    <bpmn:sequenceFlow id="F02" sourceRef="Task_Request" targetRef="Gateway_Category"/>
    <bpmn:sequenceFlow id="F03" name="ستاد" sourceRef="Gateway_Category" targetRef="Gateway_Direct"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof RequestCategory !== 'undefined' &amp;&amp; RequestCategory == 'HQ';</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F04" name="استان" sourceRef="Gateway_Category" targetRef="Task_ProvinceReview_PR"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof RequestCategory !== 'undefined' &amp;&amp; RequestCategory == 'Province';</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow name="سایر (اول مدیر مستقیم)" id="F03a" sourceRef="Gateway_Direct" targetRef="Task_CEOReview"/>
    <bpmn:sequenceFlow id="F03b" name="مدیرعامل (اول رئیس اداره کل سرمایه انسانی)" sourceRef="Gateway_Direct" targetRef="Task_HRHeadAssign"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof UpperManagerTitle !== "undefined" &amp;&amp; UpperManagerTitle == "مدیرعامل";</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F05" sourceRef="Task_CEOReview" targetRef="Gateway_CEO"/>
    <bpmn:sequenceFlow name="بله" id="F06" sourceRef="Gateway_CEO" targetRef="Task_HRHeadAssign">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof CEOApproval !== "undefined" &amp;&amp; CEOApproval == "approved";</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow name="خیر" id="F07" sourceRef="Gateway_CEO" targetRef="End_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof CEOApproval !== "undefined" &amp;&amp; CEOApproval == "rejected";</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_HRHead_Expert" sourceRef="Task_HRHeadAssign" targetRef="Task_HRExpert"/>
    <bpmn:sequenceFlow id="Flow_HRExpert_HR" sourceRef="Task_HRExpert" targetRef="Task_HRReview"/>
    <bpmn:sequenceFlow id="F11" sourceRef="Task_HRReview" targetRef="Gateway_HR"/>
    <bpmn:sequenceFlow name="بله" id="F12" sourceRef="Gateway_HR" targetRef="Gateway_Fork">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof HRApproval !== "undefined" &amp;&amp; HRApproval == "approved";</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F14" name="خیر" sourceRef="Gateway_HR" targetRef="End_RejectedHQ"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof HRApproval === "undefined" || HRApproval != "approved";</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F16" sourceRef="Gateway_Fork" targetRef="Task_Inspection"/>
    <bpmn:sequenceFlow id="Flow_Insp_Join" sourceRef="Task_Inspection" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow name="تأیید مدیر مافوق" id="F15" sourceRef="Gateway_Fork" targetRef="Task_FinalApproval"/>
    <bpmn:sequenceFlow id="Flow_FA_G" sourceRef="Task_FinalApproval" targetRef="Gateway_Final"/>
    <bpmn:sequenceFlow name="بله" id="Flow_FA_Yes" sourceRef="Gateway_Final" targetRef="Task_HRHeadReferral">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof FinalApproval !== "undefined" &amp;&amp; FinalApproval == "approved";</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow name="خیر" id="Flow_FA_No" sourceRef="Gateway_Final" targetRef="End_RejectedFinal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof FinalApproval === "undefined" || FinalApproval != "approved";</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_HRRef_Route" sourceRef="Task_HRHeadReferral" targetRef="Task_ReferralBranch"/>
    <bpmn:sequenceFlow id="F22" sourceRef="Task_ReferralBranch" targetRef="Task_Legal"/>
    <bpmn:sequenceFlow id="F23" sourceRef="Task_Legal" targetRef="Task_File"/>
    <bpmn:sequenceFlow id="F24" sourceRef="Task_File" targetRef="Task_BranchRefAcc"/>
    <bpmn:sequenceFlow id="Flow_BR_AA" sourceRef="Task_BranchRefAcc" targetRef="Task_AccApproval"/>
    <bpmn:sequenceFlow id="Flow_AA_G" sourceRef="Task_AccApproval" targetRef="Gateway_Acc"/>
    <bpmn:sequenceFlow name="بله" id="Flow_Acc_Yes" sourceRef="Gateway_Acc" targetRef="Task_Payment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof AccApproval !== "undefined" &amp;&amp; AccApproval == "approved";</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow name="خیر" id="Flow_Acc_No" sourceRef="Gateway_Acc" targetRef="End_RejectedAcc">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof AccApproval === "undefined" || AccApproval != "approved";</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F25" sourceRef="Task_Payment" targetRef="Task_BranchRefAccountant"/>
    <bpmn:sequenceFlow id="Flow_BRA_Lease" sourceRef="Task_BranchRefAccountant" targetRef="Task_LeaseInfo"/>
    <bpmn:sequenceFlow id="F27" sourceRef="Task_LeaseInfo" targetRef="Task_Database"/>
    <bpmn:sequenceFlow id="Flow_DB_Join" sourceRef="Task_Database" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Join_End" sourceRef="Gateway_Join" targetRef="End_Completed" />
    <bpmn:sequenceFlow id="F08_PR" sourceRef="Task_ProvinceReview_PR" targetRef="Gateway_Province_PR"/>
    <bpmn:sequenceFlow name="بله" id="F09_PR" sourceRef="Gateway_Province_PR" targetRef="Gateway_IsSec_PR">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof ProvinceApproval !== "undefined" &amp;&amp; ProvinceApproval == "approved";</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow name="خیر" id="F10_PR" sourceRef="Gateway_Province_PR" targetRef="End_Rejected_PR">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof ProvinceApproval !== "undefined" &amp;&amp; ProvinceApproval == "rejected";</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow name="بله" id="Flow_IsSec_Yes_PR" sourceRef="Gateway_IsSec_PR" targetRef="Task_SecurityReview_PR">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof PostTitle !== "undefined" &amp;&amp; String(PostTitle).indexOf("حراست") &gt;= 0;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow name="خیر" id="Flow_IsSec_No_PR" sourceRef="Gateway_IsSec_PR" targetRef="Task_HRHeadAssign_PR"/>
    <bpmn:sequenceFlow id="Flow_Sec_G_PR" sourceRef="Task_SecurityReview_PR" targetRef="Gateway_SecOK_PR"/>
    <bpmn:sequenceFlow name="بله" id="Flow_Sec_Yes_PR" sourceRef="Gateway_SecOK_PR" targetRef="Task_HRHeadAssign_PR">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof SecurityApproval !== "undefined" &amp;&amp; SecurityApproval == "approved";</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow name="خیر" id="Flow_Sec_No_PR" sourceRef="Gateway_SecOK_PR" targetRef="End_RejectedSec_PR">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof SecurityApproval === "undefined" || SecurityApproval != "approved";</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_HRHead_Expert_PR" sourceRef="Task_HRHeadAssign_PR" targetRef="Task_HRExpert_PR"/>
    <bpmn:sequenceFlow id="Flow_HRExpert_HR_PR" sourceRef="Task_HRExpert_PR" targetRef="Task_HRReview_PR"/>
    <bpmn:sequenceFlow id="F11_PR" sourceRef="Task_HRReview_PR" targetRef="Gateway_HR_PR"/>
    <bpmn:sequenceFlow name="بله" id="F12_PR" sourceRef="Gateway_HR_PR" targetRef="Gateway_Fork_PR">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof HRApproval !== "undefined" &amp;&amp; HRApproval == "approved";</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F13_PR" name="خیر (بازگشت به مدیریت شعب استان)" sourceRef="Gateway_HR_PR" targetRef="Task_ProvinceReview_PR"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof HRApproval === "undefined" || HRApproval != "approved";</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F16_PR" sourceRef="Gateway_Fork_PR" targetRef="Task_Inspection_PR"/>
    <bpmn:sequenceFlow id="Flow_Insp_Join_PR" sourceRef="Task_Inspection_PR" targetRef="Gateway_Join_PR" />
    <bpmn:sequenceFlow id="F15_PR" sourceRef="Gateway_Fork_PR" targetRef="Task_HRHeadReferral_PR"/>
