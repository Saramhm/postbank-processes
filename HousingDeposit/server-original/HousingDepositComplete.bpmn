  else { var n = new Date(); iso = (n.getFullYear() + 1) + "-" + hdPad(n.getMonth() + 1) + "-" + hdPad(n.getDate()) + "T08:00:00"; }
  execution.setVariable("_exitDueDate", iso);
  console.log("[Task_Database] _exitDueDate=" + iso);
} catch (e) { console.error("[Task_Database] " + e); execution.setVariable("_exitDueDate", "2099-01-01T08:00:00"); }
