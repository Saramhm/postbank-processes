    <bpmn:sequenceFlow id="Flow_CEO_N" sourceRef="Task_CEOReview" targetRef="Notify_CEO" />
    <bpmn:sequenceFlow id="Flow_N_CEO_G" sourceRef="Notify_CEO" targetRef="Gateway_CEO" />
    <bpmn:sequenceFlow id="Flow_CEO_Yes" name="بله" sourceRef="Gateway_CEO" targetRef="Gateway_ToHR">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${_ceoApproval == "approved"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CEO_No" name="خیر" sourceRef="Gateway_CEO" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="Flow_Prov_N" sourceRef="Task_ProvinceReview" targetRef="Notify_Province" />
    <bpmn:sequenceFlow id="Flow_N_Prov_G" sourceRef="Notify_Province" targetRef="Gateway_Province" />
    <bpmn:sequenceFlow id="Flow_Prov_Yes" name="بله" sourceRef="Gateway_Province" targetRef="Gateway_ToHR">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${_provinceApproval == "approved"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Prov_No" name="خیر" sourceRef="Gateway_Province" targetRef="End_RejectedProv" />
    <bpmn:sequenceFlow id="Flow_ToHR" sourceRef="Gateway_ToHR" targetRef="Task_HRReview" />
    <bpmn:sequenceFlow id="Flow_HR_N" sourceRef="Task_HRReview" targetRef="Notify_HR" />
    <bpmn:sequenceFlow id="Flow_N_HR_G" sourceRef="Notify_HR" targetRef="Gateway_HR" />
    <bpmn:sequenceFlow id="Flow_HR_Yes" name="بله" sourceRef="Gateway_HR" targetRef="Gateway_Fork">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${_hrApproval == "approved"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_HR_NoHQ" name="خیر (ستاد)" sourceRef="Gateway_HR" targetRef="End_RejectedHQ">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${_hrApproval != "approved" &amp;&amp; _requestCategory == "HQ"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_HR_NoProv" name="خیر (استان – بازگشت)" sourceRef="Gateway_HR" targetRef="Task_ProvinceReview" />
    <bpmn:sequenceFlow id="Flow_Fork_Insp" sourceRef="Gateway_Fork" targetRef="Task_Inspection" />
    <bpmn:sequenceFlow id="Flow_Insp_End" sourceRef="Task_Inspection" targetRef="End_Inspection" />
    <bpmn:sequenceFlow id="Flow_Route_HQ" name="ستاد" sourceRef="Gateway_Route" targetRef="Task_ReferralBranch">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${_requestCategory == "HQ"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Route_Prov" name="استان" sourceRef="Gateway_Route" targetRef="Task_Referral" />
    <bpmn:sequenceFlow id="Flow_Ref_N" sourceRef="Task_Referral" targetRef="Notify_Legal" />
    <bpmn:sequenceFlow id="Flow_RefB_N" sourceRef="Task_ReferralBranch" targetRef="Notify_Legal" />
    <bpmn:sequenceFlow id="Flow_N_Legal" sourceRef="Notify_Legal" targetRef="Task_Legal" />
    <bpmn:sequenceFlow id="Flow_Legal_File" sourceRef="Task_Legal" targetRef="Task_File" />
    <bpmn:sequenceFlow id="Flow_File_Pay" sourceRef="Task_File" targetRef="Task_Payment" />
    <bpmn:sequenceFlow id="Flow_Pay_N" sourceRef="Task_Payment" targetRef="Notify_Paid" />
    <bpmn:sequenceFlow id="Flow_N_Paid_DB" sourceRef="Notify_Paid" targetRef="Task_LeaseInfo" />
    <bpmn:sequenceFlow id="Flow_DB_N" sourceRef="Task_Database" targetRef="Notify_Done" />
    <bpmn:sequenceFlow id="Flow_N_Done_Wait" sourceRef="Notify_Done" targetRef="Gateway_ExitWait" />
    <bpmn:sequenceFlow id="Flow_Wait_Msg" sourceRef="Gateway_ExitWait" targetRef="Catch_ExitMessage" />
    <bpmn:sequenceFlow id="Flow_Wait_Due" sourceRef="Gateway_ExitWait" targetRef="Catch_SettlementDue" />
    <bpmn:sequenceFlow id="Flow_Msg_NExit" name="رویداد خاص" sourceRef="Catch_ExitMessage" targetRef="Notify_Exit" />
    <bpmn:sequenceFlow id="Flow_Due_NExit" name="سررسید" sourceRef="Catch_SettlementDue" targetRef="Notify_Exit" />
    <bpmn:sequenceFlow id="Flow_NExit_NSet" sourceRef="Notify_Exit" targetRef="Notify_Settlement" />
    <bpmn:sequenceFlow id="Flow_NSet_End" sourceRef="Notify_Settlement" targetRef="End_Handover" />
    <bpmn:sequenceFlow id="Flow_Fork_Route" sourceRef="Gateway_Fork" targetRef="Gateway_Route" />
    <bpmn:sequenceFlow id="Flow_Lease_DB" sourceRef="Task_LeaseInfo" targetRef="Task_Database" />
  </bpmn:process>
