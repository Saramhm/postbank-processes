    <bpmn:intermediateThrowEvent id="Notify_Settlement" name="ارجاع به فرآیند تسویه حساب">
      <bpmn:documentation>خروج از شمول یا سررسید تسویه اعلام شده است. ادامه کار (اعلام تسویه، دریافت وجه، اسناد معکوس، خسارت تأخیر و اقدام حقوقی) در فرآیند مستقل HousingDepositSettlement انجام می‌شود.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="javascript">try {
  var raw = execution.getVariable("Submission");
  var obj = null;
  if (raw === null || raw === undefined) { obj = { data: {} }; }
  else if (typeof raw === "string") { obj = JSON.parse(raw); }
  else if (raw &amp;&amp; typeof raw.prop === "function") { obj = JSON.parse(raw.toString()); }
  else { try { obj = JSON.parse(JSON.stringify(raw)); } catch (e1) { obj = { data: {} }; } }
  if (!obj.data) { obj = { data: obj }; }
  obj.data.SettlementTrigger = "exit";
  obj.data.StateTask = "1";
  var HashMap = Java.type("java.util.HashMap");
  var vars = new HashMap();
  var pm = execution.getVariable("PM");
  if (pm) { vars.put("PM", String(pm)); }
  vars.put("StateTask", "1");
  vars.put("_requestCategory", String(obj.data.RequestCategory || ""));
  vars.put("SourceProcessInstanceId", execution.getProcessInstanceId());
  vars.put("Submission", S(JSON.stringify(obj)));
  var rs = execution.getProcessEngineServices().getRuntimeService();
  var bk = execution.getProcessBusinessKey();
  if (bk) { rs.startProcessInstanceByKey("HousingDepositSettlement", String(bk), vars); }
  else { rs.startProcessInstanceByKey("HousingDepositSettlement", vars); }
  console.log("[Notify_Settlement] HousingDepositSettlement started");
} catch (e) { console.error("[Notify_Settlement] " + e); }
</camunda:script>
        </camunda:executionListener>
