    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="Gateway_CEO" name="آیا مورد تأیید می‌باشد؟" default="Flow_CEO_No">
      <bpmn:incoming>Flow_N_CEO_G</bpmn:incoming>
