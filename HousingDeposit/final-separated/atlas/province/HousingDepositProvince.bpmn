<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_HousingDepositProvince" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.26.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.17.0">
  <bpmn:collaboration id="Collaboration_HousingDepositProvince">
    <bpmn:participant id="Participant_HousingDepositProvince" name="پست بانک ایران – استان / منطقه" processRef="HousingDepositProvince" />
  </bpmn:collaboration>
  <bpmn:process id="HousingDepositProvince" name="ودیعه مسکن مدیران غیربومی – استان / منطقه" isExecutable="true">
    <bpmn:laneSet id="LaneSet_HousingDepositProvince">
      <bpmn:lane id="Lane_Employee" name="کارکنان مشمول استان / منطقه">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ProvinceManagement" name="مدیریت شعب استان / منطقه">
        <bpmn:flowNodeRef>Task_ProvinceReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Province</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IsSec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReferralProvince</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Security" name="مدیریت امور حراست">
        <bpmn:flowNodeRef>Task_SecurityReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SecOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RejectedSec</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="اداره کل سرمایه انسانی و رفاه">
        <bpmn:flowNodeRef>Task_HRHeadAssign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HRExpert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HRReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HRHeadReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Database</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Inspection" name="اداره کل بازرسی">
        <bpmn:flowNodeRef>Task_Inspection</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Legal" name="واحد حقوقی (مدیریت شعب استان / منطقه)">
        <bpmn:flowNodeRef>Task_Legal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Executor" name="ذی‌حساب مدیریت شعب استان / منطقه">
        <bpmn:flowNodeRef>Task_File</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LeaseInfo</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Request" name="ارائه درخواست ودیعه مسکن (استان / منطقه)" camunda:asyncBefore="true" camunda:formKey="FORM_PR_01" camunda:assignee="${starter}">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ProvinceReview" name="بررسی و تأیید – مدیریت شعب استان / منطقه" camunda:asyncBefore="true" camunda:formKey="FORM_PR_02" camunda:assignee="${starter}">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Province" name="آیا مورد تأیید است؟">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Rejected" name="پایان (عدم تأیید مدیریت شعب استان)">
      <bpmn:incoming>F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_IsSec" name="رئیس حوزه حراست استان؟" default="Flow_IsSec_No">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>Flow_IsSec_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_IsSec_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_SecurityReview" name="بررسی و تأیید – مدیر امور حراست" camunda:asyncBefore="true" camunda:formKey="FORM_PR_03" camunda:assignee="${starter}">
      <bpmn:incoming>Flow_IsSec_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Sec_G</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_SecOK" name="آیا مورد تأیید می‌باشد؟">
      <bpmn:incoming>Flow_Sec_G</bpmn:incoming>
      <bpmn:outgoing>Flow_Sec_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Sec_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_RejectedSec" name="پایان (عدم تأیید مدیر امور حراست)">
      <bpmn:incoming>Flow_Sec_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_HRHeadAssign" name="رئیس اداره کل سرمایه انسانی – ارجاع به کارشناس" camunda:asyncBefore="true" camunda:formKey="FORM_PR_04" camunda:assignee="${starter}">
      <bpmn:incoming>Flow_IsSec_No</bpmn:incoming>
      <bpmn:incoming>Flow_Sec_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_HRHead_Expert</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_HRExpert" name="بررسی درخواست – کارشناس اداره کل سرمایه انسانی" camunda:asyncBefore="true" camunda:formKey="FORM_PR_05" camunda:assignee="${starter}">
      <bpmn:incoming>Flow_HRHead_Expert</bpmn:incoming>
      <bpmn:outgoing>Flow_HRExpert_HR</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_HRReview" name="بررسی و تأیید – رئیس اداره کل سرمایه انسانی" camunda:asyncBefore="true" camunda:formKey="FORM_PR_06" camunda:assignee="${starter}">
      <bpmn:incoming>Flow_HRExpert_HR</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_HR" name="آیا مورد تأیید می‌باشد؟">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_Fork" name="رونوشت به بازرسی (همزمان)">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_Inspection" name="رونوشت به اداره کل بازرسی" camunda:asyncBefore="true" camunda:formKey="FORM_PR_13" camunda:assignee="${starter}">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>Flow_Insp_Join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_HRHeadReferral" name="رئیس اداره کل سرمایه انسانی – ارجاع به مدیریت شعب استان / منطقه" camunda:asyncBefore="true" camunda:formKey="FORM_PR_04" camunda:assignee="${starter}">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>Flow_HRRef_Route</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReferralProvince" name="ارجاع برای پرداخت – مدیریت شعب استان / منطقه" camunda:asyncBefore="true" camunda:formKey="FORM_PR_07" camunda:assignee="${starter}">
      <bpmn:incoming>Flow_HRRef_Route</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Legal" name="اخذ چک صیادی (۱۳۰٪)، اقرارنامه و ضمانت – واحد حقوقی مدیریت شعب" camunda:asyncBefore="true" camunda:formKey="FORM_PR_08" camunda:assignee="${starter}">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_File" name="تشکیل پرونده – ذی‌حساب مدیریت شعب استان / منطقه" camunda:asyncBefore="true" camunda:formKey="FORM_PR_09" camunda:assignee="${starter}">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Payment" name="واریز ودیعه و صدور سند حسابداری – ذی‌حساب مدیریت شعب استان / منطقه" camunda:asyncBefore="true" camunda:formKey="FORM_PR_10" camunda:assignee="${starter}">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_LeaseInfo" name="تکمیل اطلاعات ملک و قرارداد اجاره – ذی‌حساب" camunda:asyncBefore="true" camunda:formKey="FORM_PR_11" camunda:assignee="${starter}">
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Database" name="دریافت مستندات و تکمیل بانک اطلاعات دریافت‌کنندگان" camunda:asyncBefore="true" camunda:formKey="FORM_PR_12" camunda:assignee="${starter}">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>Flow_DB_Join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_Join" name="پایان همزمان (رونوشت بازرسی و تکمیل پرونده)">
      <bpmn:incoming>Flow_Insp_Join</bpmn:incoming>
      <bpmn:incoming>Flow_DB_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_End</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:endEvent id="End_Completed" name="پایان (تکمیل پرونده)">
      <bpmn:incoming>Flow_Join_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="StartEvent_1" targetRef="Task_Request"/>
    <bpmn:sequenceFlow id="F02" sourceRef="Task_Request" targetRef="Task_ProvinceReview"/>
    <bpmn:sequenceFlow id="F08" sourceRef="Task_ProvinceReview" targetRef="Gateway_Province"/>
    <bpmn:sequenceFlow name="بله" id="F09" sourceRef="Gateway_Province" targetRef="Gateway_IsSec">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof ProvinceApproval !== "undefined" &amp;&amp; ProvinceApproval == "approved";</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow name="خیر" id="F10" sourceRef="Gateway_Province" targetRef="End_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof ProvinceApproval !== "undefined" &amp;&amp; ProvinceApproval == "rejected";</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow name="بله" id="Flow_IsSec_Yes" sourceRef="Gateway_IsSec" targetRef="Task_SecurityReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof PostTitle !== "undefined" &amp;&amp; String(PostTitle).indexOf("حراست") &gt;= 0;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow name="خیر" id="Flow_IsSec_No" sourceRef="Gateway_IsSec" targetRef="Task_HRHeadAssign"/>
    <bpmn:sequenceFlow id="Flow_Sec_G" sourceRef="Task_SecurityReview" targetRef="Gateway_SecOK"/>
    <bpmn:sequenceFlow name="بله" id="Flow_Sec_Yes" sourceRef="Gateway_SecOK" targetRef="Task_HRHeadAssign">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof SecurityApproval !== "undefined" &amp;&amp; SecurityApproval == "approved";</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow name="خیر" id="Flow_Sec_No" sourceRef="Gateway_SecOK" targetRef="End_RejectedSec">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof SecurityApproval === "undefined" || SecurityApproval != "approved";</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_HRHead_Expert" sourceRef="Task_HRHeadAssign" targetRef="Task_HRExpert"/>
    <bpmn:sequenceFlow id="Flow_HRExpert_HR" sourceRef="Task_HRExpert" targetRef="Task_HRReview"/>
    <bpmn:sequenceFlow id="F11" sourceRef="Task_HRReview" targetRef="Gateway_HR"/>
    <bpmn:sequenceFlow name="بله" id="F12" sourceRef="Gateway_HR" targetRef="Gateway_Fork">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof HRApproval !== "undefined" &amp;&amp; HRApproval == "approved";</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F13" name="خیر (بازگشت به مدیریت شعب استان)" sourceRef="Gateway_HR" targetRef="Task_ProvinceReview"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">typeof HRApproval === "undefined" || HRApproval != "approved";</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F16" sourceRef="Gateway_Fork" targetRef="Task_Inspection"/>
    <bpmn:sequenceFlow id="Flow_Insp_Join" sourceRef="Task_Inspection" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="F15" sourceRef="Gateway_Fork" targetRef="Task_HRHeadReferral"/>
    <bpmn:sequenceFlow id="Flow_HRRef_Route" sourceRef="Task_HRHeadReferral" targetRef="Task_ReferralProvince"/>
    <bpmn:sequenceFlow id="F21" sourceRef="Task_ReferralProvince" targetRef="Task_Legal"/>
    <bpmn:sequenceFlow id="F23" sourceRef="Task_Legal" targetRef="Task_File"/>
    <bpmn:sequenceFlow id="F24" sourceRef="Task_File" targetRef="Task_Payment"/>
    <bpmn:sequenceFlow id="F25" sourceRef="Task_Payment" targetRef="Task_LeaseInfo"/>
    <bpmn:sequenceFlow id="F27" sourceRef="Task_LeaseInfo" targetRef="Task_Database"/>
    <bpmn:sequenceFlow id="Flow_DB_Join" sourceRef="Task_Database" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Join_End" sourceRef="Gateway_Join" targetRef="End_Completed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_HousingDepositProvince">
    <bpmndi:BPMNPlane id="BPMNPlane_HousingDepositProvince" bpmnElement="Collaboration_HousingDepositProvince">
      <bpmndi:BPMNShape id="Participant_HousingDepositProvince_di" bpmnElement="Participant_HousingDepositProvince" isHorizontal="true">
        <dc:Bounds x="129" y="80" width="3190" height="1120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Employee_di" bpmnElement="Lane_Employee" isHorizontal="true">
        <dc:Bounds x="159" y="80" width="3160" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ProvinceManagement_di" bpmnElement="Lane_ProvinceManagement" isHorizontal="true">
        <dc:Bounds x="159" y="240" width="3160" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Security_di" bpmnElement="Lane_Security" isHorizontal="true">
        <dc:Bounds x="159" y="400" width="3160" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_HR_di" bpmnElement="Lane_HR" isHorizontal="true">
        <dc:Bounds x="159" y="560" width="3160" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Inspection_di" bpmnElement="Lane_Inspection" isHorizontal="true">
        <dc:Bounds x="159" y="720" width="3160" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Legal_di" bpmnElement="Lane_Legal" isHorizontal="true">
        <dc:Bounds x="159" y="880" width="3160" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Executor_di" bpmnElement="Lane_Executor" isHorizontal="true">
        <dc:Bounds x="159" y="1040" width="3160" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="172" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="142" y="182" width="96" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Request_di" bpmnElement="Task_Request">
        <dc:Bounds x="240" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ProvinceReview_di" bpmnElement="Task_ProvinceReview">
        <dc:Bounds x="380" y="280" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Province_di" bpmnElement="Gateway_Province" isMarkerVisible="true">
        <dc:Bounds x="565" y="295" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="530" y="263" width="120" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Rejected_di" bpmnElement="End_Rejected">
        <dc:Bounds x="572" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="542" y="182" width="96" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_IsSec_di" bpmnElement="Gateway_IsSec" isMarkerVisible="true">
        <dc:Bounds x="675" y="295" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="640" y="263" width="120" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SecurityReview_di" bpmnElement="Task_SecurityReview">
        <dc:Bounds x="770" y="440" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_SecOK_di" bpmnElement="Gateway_SecOK" isMarkerVisible="true">
        <dc:Bounds x="945" y="455" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="910" y="423" width="120" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_RejectedSec_di" bpmnElement="End_RejectedSec">
        <dc:Bounds x="952" y="524" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="922" y="564" width="96" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_HRHeadAssign_di" bpmnElement="Task_HRHeadAssign">
        <dc:Bounds x="1040" y="600" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_HRExpert_di" bpmnElement="Task_HRExpert">
        <dc:Bounds x="1200" y="600" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_HRReview_di" bpmnElement="Task_HRReview">
        <dc:Bounds x="1360" y="600" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_HR_di" bpmnElement="Gateway_HR" isMarkerVisible="true">
        <dc:Bounds x="1535" y="615" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1500" y="583" width="120" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Fork_di" bpmnElement="Gateway_Fork">
        <dc:Bounds x="1635" y="615" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1600" y="583" width="120" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Inspection_di" bpmnElement="Task_Inspection">
        <dc:Bounds x="1740" y="760" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_HRHeadReferral_di" bpmnElement="Task_HRHeadReferral">
        <dc:Bounds x="1740" y="600" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReferralProvince_di" bpmnElement="Task_ReferralProvince">
        <dc:Bounds x="1900" y="280" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Legal_di" bpmnElement="Task_Legal">
        <dc:Bounds x="2060" y="920" width="120" height="80" />
