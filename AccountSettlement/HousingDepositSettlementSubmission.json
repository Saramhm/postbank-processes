nt', PostTitle: 'postTitle',\n    PostLevel: 'postLevel', AssignmentDate: 'assignmentDate' };\n  var apply = function (e) {\n    if (!e) { return; }\n    setTimeout(function () {\n      Object.keys(map).forEach(function (key) {\n        var c = instance.root.getComponent(key);\n        if (c && !c.getValue() && e[map[key]]) { c.setValue(e[map[key]]); }\n      });\n    }, 300);\n  };\n  if (api && typeof fetch === 'function') {\n    fetch(api + encodeURIComponent(uid)).then(function (r) { return r.ok ? r.json() : null; })\n      .then(function (e) { apply(e || local); }).catch(function () { apply(local); });\n  } else { apply(local); }\n}",
