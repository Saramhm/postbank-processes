    {
      "label": "ثبت درخواست تسویه و شروع فرآیند",
      "showValidations": false,
      "theme": "success",
      "size": "lg",
      "block": true,
      "tableView": false,
      "key": "submit",
      "type": "button",
      "action": "custom",
      "input": true,
      "custom": "(function() {\n    try {\n        // دریافت نمونه فرم با اولویت instance.root (استاندارد Form.io در Camunda)\n        const form = instance.root || (document.querySelector('.formio') ? document.querySelector('.formio').formio : null);\n        if (!form) {\n            console.error('Form instance not found');\n            return;\n        }\n\n        // 1. غیرفعال کردن و مخفی کردن هشدارهای پیش‌فرض بالای صفحه\n        form.options = form.options || {};\n        form.options.disableAlerts = true; form.options.noAlerts = true;\n        const alertBox = document.querySelector('.formio-alerts');\n        if (alertBox) alertBox.style.display = 'none';\n\n        const submitBtn = (instance.refs && instance.refs.button) || document.querySelector('button[name=\"data[' + instance.key + ']\"]') || document.querySelector('button[data-key=\"submit\"]');\n        const originalText = submitBtn ? submitBtn.innerHTML : 'ثبت و ادامه فرآیند';\n\n        // 2. اعتبارسنجی فرم\n        const isValid = form.checkValidity(form.data, true);\n        const errors = form.errors || [];\n\n        if (!isValid) {\n            // نمایش پاپ‌آپ با تم هماهنگ فرم\n            showThemedPopup(errors.length > 0 ? errors : [{ message: 'لطفاً فیلدهای اجباری (علامت‌دار با *) را به درستی پر کنید.' }]);\n            \n            // بازگرداندن دکمه به حالت اول\n            if (submitBtn) {\n                submitBtn.disabled = false;\n                submitBtn.style.opacity = '1';\n                submitBtn.innerHTML = originalText;\n            }\n            return; // توقف فرآیند ثبت\n        }\n\n        // 3. اگر فرم معتبر بود، ارسال آن\n        if (submitBtn) {\n            submitBtn.disabled = true;\n            submitBtn.style.opacity = '0.6';\n            submitBtn.innerHTML = '⏳ در حال پردازش...';\n        }\n\n        form.submit().then(function(submission) { try { var root = form.element || document; Array.prototype.forEach.call(root.querySelectorAll('.alert-success, [ref=\"buttonMessageContainer\"]'), function (el) { el.style.display = 'none'; }); } catch (e0) {}\n            // عملیات موفقیت‌آمیز (فرم به طور خودکار توسط Camunda مدیریت می‌شود)\n        }).catch(function(err) {\n            console.error('Submit error:', err);\n            if (submitBtn) {\n                submitBtn.disabled = false;\n                submitBtn.style.opacity = '1';\n                submitBtn.innerHTML = originalText;\n            }\n            showThemedPopup([{ message: 'خطا در ارتباط با سرور. لطفاً اتصال شبکه را بررسی و مجدداً تلاش کنید.' }]);\n        });\n\n        // ============================================================\n        // تابع نمایش پاپ‌آپ با تم هماهنگ فرم (نارنجی و خاکستری)\n        // ============================================================\n        function showThemedPopup(errorList) {\n            if (!errorList || errorList.length === 0) return;\n            \n            const existingModal = document.getElementById('formErrorModal');\n            if (existingModal) existingModal.remove();\n            \n            const modal = document.createElement('div');\n            modal.id = 'formErrorModal';\n            modal.style.cssText = 'position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; justify-content: center; align-items: center; z-index: 99999; direction: rtl; font-family: Tahoma, \"Segoe UI\", \"IRANSans\", sans-serif; backdrop-filter: blur(2px);';\n            \n            const modalContent = document.createElement('div');\n            modalContent.style.cssText = 'background: #ffffff; border-radius: 12px; width: 90%; max-width: 500px; max-height: 80vh; box-shadow: 0 10px 40px rgba(0,0,0,0.2); animation: modalSlide 0.3s ease-out; overflow: hidden; display: flex; flex-direction: column;';\n            \n            const style = document.createElement('style');\n            style.textContent = '@keyframes modalSlide { from { transform: translateY(-30px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }';\n            document.head.appendChild(style);\n            \n            // هدر با رنگ برند فرم (#d35400)\n            const modalHeader = document.createElement('div');\n            modalHeader.style.cssText = 'background: #d35400; color: white; padding: 16px 20px; display: flex; align-items: center; gap: 12px;';\n            modalHeader.innerHTML = '<span style=\"font-size: 24px;\">⚠️</span><div><h3 style=\"margin: 0; font-size: 16px; font-weight: bold;\">بررسی اطلاعات</h3><p style=\"margin: 4px 0 0; font-size: 12px; opacity: 0.9;\">لطفاً موارد زیر را اصلاح کنید</p></div>';\n            \n            const modalBody = document.createElement('div');\n            modalBody.style.cssText = 'padding: 20px; overflow-y: auto; background: #fafafa; flex: 1;';\n            \n            const errorListContainer = document.createElement('div');\n            errorList.forEach(function(error) {\n                const fieldName = error.component ? (error.component.label || error.component.key || 'یک فیلد') : (error.field || 'یک فیلد');\n                const errorMessage = error.message || 'مقدار وارد شده معتبر نیست';\n                \n                const errorItem = document.createElement('div');\n                // تم هماهنگ با خطاهای فرم‌آی‌او (قرمز ملایم)\n                errorItem.style.cssText = 'padding: 12px 15px; margin-bottom: 10px; background: #fdf2f2; border-right: 4px solid #e74c3c; border-radius: 8px; color: #c0392b; font-size: 13px; line-height: 1.6;';\n                errorItem.innerHTML = '<strong style=\"display: block; margin-bottom: 4px; color: #a93226;\">' + escapeHtml(fieldName) + ':</strong> ' + escapeHtml(errorMessage);\n                \n                errorListContainer.appendChild(errorItem);\n            });\n            \n            modalBody.appendChild(errorListContainer);\n            \n            const modalFooter = document.createElement('div');\n            modalFooter.style.cssText = 'padding: 15px 20px; background: #ffffff; border-top: 1px solid #e9ecef; display: flex; justify-content: flex-end;';\n            \n            const closeBtn = document.createElement('button');\n            closeBtn.textContent = 'متوجه شدم';\n            closeBtn.style.cssText = 'background: #d35400; color: white; border: none; padding: 10px 24px; border-radius: 6px; font-size: 13px; font-weight: bold; cursor: pointer; transition: background 0.2s;';\n            closeBtn.onmouseover = function() { this.style.background = '#e67e22'; };\n            closeBtn.onmouseout = function() { this.style.background = '#d35400'; };\n            closeBtn.onclick = function() { modal.remove(); };\n            \n            modalFooter.appendChild(closeBtn);\n            modalContent.appendChild(modalHeader);\n            modalContent.appendChild(modalBody);\n            modalContent.appendChild(modalFooter);\n            modal.appendChild(modalContent);\n            \n            modal.onclick = function(e) { if (e.target === modal) modal.remove(); };\n            document.body.appendChild(modal);\n            \n            // فوکوس روی دکمه بستن برای دسترسی‌پذیری بهتر\n            setTimeout(() => closeBtn.focus(), 100);\n        }\n        \n        function escapeHtml(str) {\n            if (!str) return '';\n            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#039;');\n        }\n        \n    } catch (err) {\n        console.error('Submit button error:', err);\n        alert('خطایی در فرآیند ثبت رخ داده است: ' + err.message);\n    }\n})();"
    }
  ]
