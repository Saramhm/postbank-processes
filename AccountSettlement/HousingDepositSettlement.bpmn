<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_HousingDepositSettlement" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.17.0">
  <bpmn:collaboration id="Collaboration_HousingDepositSettlement">
    <bpmn:participant id="Participant_HousingDepositSettlement" name="پست بانک ایران" processRef="HousingDepositSettlement" />
  </bpmn:collaboration>
  <bpmn:process id="HousingDepositSettlement" name="تسویه حساب ودیعه مسکن مدیران غیر بومی" isExecutable="true">
    <bpmn:laneSet id="LaneSet_HousingDepositSettlement">
      <bpmn:lane id="Lane_Employee" name="کارکنان مشمول">
        <bpmn:flowNodeRef>Start_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ProvinceManagement" name="مدیریت شعب استان / منطقه / حراست">
        <bpmn:flowNodeRef>Task_ProvinceReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify_Province</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Province</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="اداره کل سرمایه انسانی و رفاه">
        <bpmn:flowNodeRef>Task_HRReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify_HR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HRExitCause</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Penalty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify_Penalty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Archive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Settled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Legal" name="مدیریت امور نظارت و حقوقی">
        <bpmn:flowNodeRef>Task_LegalClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Legal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="واحد مالی و اداری استان / منطقه">
        <bpmn:flowNodeRef>Task_Accounting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify_Accounting</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Request" name="درخواست تسویه حساب ودیعه مسکن" camunda:formKey="embedded:/camunda/forms/formioCallApi.html?deployment=HousingDepositSettlementSubmission.json&#38;var=Submission" camunda:initiator="PM">
      <bpmn:documentation>درخواست تسویه توسط مشمول ثبت می‌شود. در مسیر خودکار (خروج از شمول یا سررسید تسویه) فرآیند «ودیعه مسکن (کامل)» همین فرآیند را با همان پرونده شروع می‌کند.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">
try {
  var raw = execution.getVariable("Submission");
  if (raw === null || raw === undefined) {
    execution.setVariable("Submission", S("{\"data\":{}}"));
  } else if (typeof raw === "string") {
    execution.setVariable("Submission", S(raw));
  } else if (raw &amp;&amp; typeof raw.prop === "function") {
    // already Spin - leave it
  } else {
    try { execution.setVariable("Submission", S(JSON.stringify(raw))); }
    catch (e1) { execution.setVariable("Submission", S("{\"data\":{}}")); }
  }
} catch (e) {
  console.error("[PrepareSpin] " + e);
}
</camunda:script>
        </camunda:executionListener>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">try {
  var raw = execution.getVariable("Submission");
  var obj = null;
  if (raw === null || raw === undefined) { obj = { data: {} }; }
  else if (typeof raw === "string") { obj = JSON.parse(raw); }
  else if (raw &amp;&amp; typeof raw.prop === "function") { obj = JSON.parse(raw.toString()); }
  else { try { obj = JSON.parse(JSON.stringify(raw)); } catch (e1) { obj = { data: {} }; } }
  if (!obj.data) { obj = { data: obj }; }
  var d = obj.data;
  var cat = String(d.RequestCategory || "");
  var g = String(d.EligibilityGroup || "");
  var ttl = String(d.PostTitle || "");
  var grp;
  if (cat === "HQ") { grp = (g === "g1") ? "PBCEO" : "PBHQDeputy"; }
  else if (ttl.indexOf("حراست") &gt;= 0) { grp = "PBSecurityAffairs"; }
  else if (g === "g3") { grp = "PBProvincesAffairs"; }
  else { grp = "PBProvinceManagement"; }
  execution.setVariable("_approverGroup", grp);
  console.log("[ApproverRouting] _approverGroup=" + grp);
  execution.setVariable("_requestCategory", (d.RequestCategory !== undefined &amp;&amp; d.RequestCategory !== null) ? String(d.RequestCategory) : "");
  console.log("[Start_Request] _requestCategory=" + execution.getVariable("_requestCategory"));
} catch (e) { console.error("[Start_Request] " + e); }
</camunda:script>
        </camunda:executionListener>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">try {
  var raw = execution.getVariable("Submission");
  var obj = null;
  if (raw === null || raw === undefined) { obj = { data: {} }; }
  else if (typeof raw === "string") { obj = JSON.parse(raw); }
  else if (raw &amp;&amp; typeof raw.prop === "function") { obj = JSON.parse(raw.toString()); }
  else { try { obj = JSON.parse(JSON.stringify(raw)); } catch (e1) { obj = { data: {} }; } }
  if (!obj.data) { obj = { data: obj }; }
  var d = obj.data;
  function hdG2J(gy, gm, gd) { var g_d_m = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334]; var gy2 = (gm &gt; 2) ? (gy + 1) : gy; var days = 355666 + (365 * gy) + Math.floor((gy2 + 3) / 4) - Math.floor((gy2 + 99) / 100) + Math.floor((gy2 + 399) / 400) + gd + g_d_m[gm - 1]; var jy = -1595 + (33 * Math.floor(days / 12053)); days %= 12053; jy += 4 * Math.floor(days / 1461); days %= 1461; if (days &gt; 365) { jy += Math.floor((days - 1) / 365); days = (days - 1) % 365; } var jm, jd; if (days &lt; 186) { jm = 1 + Math.floor(days / 31); jd = 1 + (days % 31); } else { jm = 7 + Math.floor((days - 186) / 30); jd = 1 + ((days - 186) % 30); } return [jy, jm, jd]; }
function hdJ2G(jy, jm, jd) { jy += 1595; var days = -355668 + (365 * jy) + (Math.floor(jy / 33) * 8) + Math.floor(((jy % 33) + 3) / 4) + jd + ((jm &lt; 7) ? (jm - 1) * 31 : ((jm - 7) * 30) + 186); var gy = 400 * Math.floor(days / 146097); days %= 146097; if (days &gt; 36524) { days--; gy += 100 * Math.floor(days / 36524); days %= 36524; if (days &gt;= 365) { days++; } } gy += 4 * Math.floor(days / 1461); days %= 1461; if (days &gt; 365) { gy += Math.floor((days - 1) / 365); days = (days - 1) % 365; } var gd = days + 1; var ml = [0, 31, ((gy % 4 === 0 &amp;&amp; gy % 100 !== 0) || (gy % 400 === 0)) ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]; var gm; for (gm = 0; gm &lt; 13 &amp;&amp; gd &gt; ml[gm]; gm++) { gd -= ml[gm]; } return [gy, gm, gd]; }
function hdPad(n) { return (n &lt; 10 ? "0" : "") + n; }
function hdNow() { try { var Z = Java.type("java.time.ZonedDateTime"), I = Java.type("java.time.ZoneId"); var z = Z.now(I.of("Asia/Tehran")); var j = hdG2J(z.getYear(), z.getMonthValue(), z.getDayOfMonth()); return j[0] + "/" + hdPad(j[1]) + "/" + hdPad(j[2]) + " " + hdPad(z.getHour()) + ":" + hdPad(z.getMinute()); } catch (e) { var d = new Date(); var j2 = hdG2J(d.getFullYear(), d.getMonth() + 1, d.getDate()); return j2[0] + "/" + hdPad(j2[1]) + "/" + hdPad(j2[2]) + " " + hdPad(d.getHours()) + ":" + hdPad(d.getMinutes()); } }
  var exitTrigger = (d.SettlementTrigger === "exit");
  var log = d.InitiatorNotifications || [];
  log.push({ NoticeTitle: exitTrigger ? "آغاز فرآیند تسویه حساب" : "ثبت درخواست تسویه حساب",
             NoticeText: exitTrigger ? "با توجه به خروج از شمول دستورالعمل یا سررسید مهلت استفاده، فرآیند تسویه حساب ودیعه مسکن شما آغاز شد و برای بررسی به مدیریت شعب استان / منطقه ارسال گردید."
                                     : "درخواست تسویه حساب ودیعه مسکن شما ثبت شد و برای بررسی به مدیریت شعب استان / منطقه ارسال گردید.",
             NoticeTime: hdNow() });
  d.InitiatorNotifications = log;
  execution.setVariable("Submission", S(JSON.stringify(obj)));
  console.log("[Start_Request] first notice added");
} catch (e) { console.error("[Start_Request] notice " + e); }
</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Start_Request_Task_ProvinceReview</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_ProvinceReview" name="بررسی و اعلام تسویه به اداره کل سرمایه انسانی و رفاه" camunda:formKey="embedded:/camunda/forms/formioWizardCallApi.html?deployment=HousingDepositSettlementWizard.json&#38;var=Submission&#38;DefaultVal=Submission&#38;StateTask=1" camunda:assignee="${PM}" camunda:candidateGroups="${_approverGroup}">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="javascript">
try {
  var raw = execution.getVariable("Submission");
  var obj = null;
  if (raw === null || raw === undefined) { obj = { data: {} }; }
  else if (typeof raw === "string") { obj = JSON.parse(raw); }
  else if (raw &amp;&amp; typeof raw.prop === "function") { obj = JSON.parse(raw.toString()); }
  else { try { obj = JSON.parse(JSON.stringify(raw)); } catch (e1) { obj = { data: {} }; } }
  if (!obj.data) { obj = { data: obj }; }
  var d = obj.data;
  // Inject StateTask into form data so panel customConditional works
  obj.data.StateTask = "1";
  execution.setVariable("StateTask", "1");
  execution.setVariable("Submission", S(JSON.stringify(obj)));
  console.log("[Prepare] StateTask=1 injected into Submission.data");
} catch (e) {
  console.error("[Prepare] " + e);
  execution.setVariable("StateTask", "1");
}
</camunda:script>
        </camunda:executionListener>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">try {
  var raw = execution.getVariable("Submission");
  var obj = null;
  if (raw === null || raw === undefined) { obj = { data: {} }; }
  else if (typeof raw === "string") { obj = JSON.parse(raw); }
  else if (raw &amp;&amp; typeof raw.prop === "function") { obj = JSON.parse(raw.toString()); }
  else { try { obj = JSON.parse(JSON.stringify(raw)); } catch (e1) { obj = { data: {} }; } }
  if (!obj.data) { obj = { data: obj }; }
  var d = obj.data;
  execution.setVariable("_provinceApproval", (d.ProvinceApproval !== undefined &amp;&amp; d.ProvinceApproval !== null) ? String(d.ProvinceApproval) : "");
  console.log("[Task_ProvinceReview] _provinceApproval=" + execution.getVariable("_provinceApproval"));
} catch (e) { console.error("[Task_ProvinceReview] " + e); }
</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Request_Task_ProvinceReview</bpmn:incoming>
      <bpmn:incoming>Flow_Gateway_HR_Task_ProvinceReview</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_ProvinceReview_Notify_Province</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="Notify_Province" name="اطلاع نتیجه به متقاضی">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
