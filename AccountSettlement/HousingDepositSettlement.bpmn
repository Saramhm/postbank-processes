      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${_provinceApproval == "approved"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_Province_Notify_Rejected" name="خیر" sourceRef="Gateway_Province" targetRef="Notify_Rejected" />
    <bpmn:sequenceFlow id="Flow_Notify_Rejected_End_Rejected" sourceRef="Notify_Rejected" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="Flow_Task_HRReview_Notify_HR" sourceRef="Task_HRReview" targetRef="Notify_HR" />
    <bpmn:sequenceFlow id="Flow_Notify_HR_Gateway_HR" sourceRef="Notify_HR" targetRef="Gateway_HR" />
    <bpmn:sequenceFlow id="Flow_Gateway_HR_Task_HRExitCause" name="بله" sourceRef="Gateway_HR" targetRef="Task_HRExitCause">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${_hrApproval == "approved"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_HR_Task_ProvinceReview" name="خیر (بازگشت برای بازبینی)" sourceRef="Gateway_HR" targetRef="Task_ProvinceReview" />
    <bpmn:sequenceFlow id="Flow_Task_HRExitCause_Gateway_Paid" sourceRef="Task_HRExitCause" targetRef="Gateway_Paid" />
    <bpmn:sequenceFlow id="Flow_Gateway_Paid_Task_Accounting" name="بله" sourceRef="Gateway_Paid" targetRef="Task_Accounting">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${_paidByEmployee == "yes"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_Paid_Task_Penalty" name="خیر" sourceRef="Gateway_Paid" targetRef="Task_Penalty" />
    <bpmn:sequenceFlow id="Flow_Task_Accounting_Notify_Accounting" sourceRef="Task_Accounting" targetRef="Notify_Accounting" />
    <bpmn:sequenceFlow id="Flow_Notify_Accounting_Task_Archive" sourceRef="Notify_Accounting" targetRef="Task_Archive" />
    <bpmn:sequenceFlow id="Flow_Task_Archive_End_Settled" sourceRef="Task_Archive" targetRef="End_Settled" />
    <bpmn:sequenceFlow id="Flow_Task_Penalty_Notify_Penalty" sourceRef="Task_Penalty" targetRef="Notify_Penalty" />
    <bpmn:sequenceFlow id="Flow_Notify_Penalty_Task_LegalClaim" sourceRef="Notify_Penalty" targetRef="Task_LegalClaim" />
    <bpmn:sequenceFlow id="Flow_Task_LegalClaim_End_Legal" sourceRef="Task_LegalClaim" targetRef="End_Legal" />
  </bpmn:process>
